  "main": {
    "fileName": "main.c",
    "origin": "$6000",
    "source": "#include <stdint.h>\n#include <assets/generated.h>\n#include <web64/sprite-runtime.h>\n#include <web64/sprite-mux.h>\n\n#define POINTER_TABLE 0x07f8\n#define PILOT_BASE_POINTER 0xc0\n#define PILOT_OVERLAY_POINTER 0xc4\n#define MUX_OWNED_SLOTS 0xfc\n#define MUX_CAPACITY 24\n\nvoid example_copy_sprite_data(void);\nvoid example_install_irq(void);\n\nWEB64_SPRITE_MUX_STORAGE(sprite_mux, MUX_CAPACITY);\nWeb64SpriteRenderer direct_renderer;\nWeb64SpriteOverlayBinding pilot_binding;\n\nvolatile uint8_t frame_tick;\nvolatile uint8_t example_irq_count;\nvolatile uint8_t example_irq_entry_line;\nvolatile uint8_t example_irq_exit_line;\nuint8_t animation_frame;\nuint8_t overlay_animation_frame;\nuint8_t crowd_phase;\nuint8_t observed_tick;\nuint16_t pilot_x;\nuint8_t last_accepted_entries;\nuint8_t last_dropped_entries;\nuint8_t last_accepted_layers;\nuint8_t last_dropped_layers;\nuint16_t verification_first_x;\nuint16_t verification_second_x;\nuint8_t verification_irq_count;\nuint8_t verification_complete;\n\n/* Unsigned, 24-centered, 32-sample sine lookup: no motion runtime required. */\nuint8_t sprite_wave[32] = {\n    24, 29, 33, 37, 41, 44, 46, 47,\n    48, 47, 46, 44, 41, 37, 33, 29,\n    24, 19, 15, 11, 7, 4, 2, 1,\n    0, 1, 2, 4, 7, 11, 15, 19\n};\n\nvoid example_advance_animation(void) {\n    animation_frame = (animation_frame + 1) & 3;\n    overlay_animation_frame = (overlay_animation_frame + 3) & 3;\n    crowd_phase = (crowd_phase + 1) & 31;\n}\n\nuint8_t example_submit_frame(void) {\n    uint8_t base_frame;\n    uint8_t overlay_frame;\n    uint8_t wave_0;\n    uint8_t wave_8;\n    uint8_t wave_16;\n    uint8_t wave_24;\n    if (web64_sprite_mux_begin_frame(&sprite_mux) != WEB64_SPRITE_MUX_OK) return 0;\n\n    /* Quarter-turn phase offsets make the nine atomic pairs weave as a field. */\n    wave_0 = sprite_wave[crowd_phase];\n    wave_8 = sprite_wave[(crowd_phase + 8) & 31];\n    wave_16 = sprite_wave[(crowd_phase + 16) & 31];\n    wave_24 = sprite_wave[(crowd_phase + 24) & 31];\n    pilot_x = 126 + wave_0;\n\n    /*\n     * Every multiplexed logical sprite is a native editor pair. The runtime\n     * converts the two independent frame indices into installed VIC pointers,\n     * keeps the layers atomic, and gives the mono overlay higher precedence.\n     */\n    base_frame = animation_frame & 3;\n    overlay_frame = overlay_animation_frame & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, pilot_x, 48,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 250\n    );\n\n    base_frame = (animation_frame + 1) & 3;\n    overlay_frame = (overlay_animation_frame + 3) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 56 + wave_8, 49,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 249\n    );\n\n    base_frame = (animation_frame + 2) & 3;\n    overlay_frame = (overlay_animation_frame + 2) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 236 + wave_16, 50,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 248\n    );\n\n    /* Each later pair reuses two slots inside one measured eight-line window. */\n    base_frame = (animation_frame + 3) & 3;\n    overlay_frame = (overlay_animation_frame + 1) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 31 + wave_24, 84,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 247\n    );\n\n    base_frame = animation_frame & 3;\n    overlay_frame = (overlay_animation_frame + 2) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 81 + wave_16, 113,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 246\n    );\n\n    base_frame = (animation_frame + 1) & 3;\n    overlay_frame = (overlay_animation_frame + 1) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 121 + wave_8, 142,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 245\n    );\n\n    base_frame = (animation_frame + 2) & 3;\n    overlay_frame = overlay_animation_frame & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 181 + wave_0, 171,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 244\n    );\n\n    base_frame = (animation_frame + 3) & 3;\n    overlay_frame = (overlay_animation_frame + 3) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 221 + wave_24, 200,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 243\n    );\n\n    base_frame = animation_frame & 3;\n    overlay_frame = (overlay_animation_frame + 1) & 3;\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 251 + wave_16, 229,\n        base_frame, overlay_frame, WEB64_SPRITE_VISIBLE, 242\n    );\n\n    /*\n     * This low-priority pair deliberately duplicates the final reuse window.\n     * Admission drops both physical layers together, never half of the pair.\n     */\n    web64_sprite_mux_submit_asset_pair(\n        &sprite_mux, &pilot_binding, 16 + wave_0, 229,\n        (animation_frame + 1) & 3, (overlay_animation_frame + 2) & 3,\n        WEB64_SPRITE_VISIBLE, 0\n    );\n\n    web64_sprite_mux_commit(&sprite_mux);\n    last_accepted_entries = sprite_mux.status.accepted_entries;\n    last_dropped_entries = sprite_mux.status.dropped_entries;\n    last_accepted_layers = sprite_mux.status.accepted_layers;\n    last_dropped_layers = sprite_mux.status.dropped_layers;\n    return 1;\n}\n\nvoid main(void) {\n    example_copy_sprite_data();\n\n    pilot_binding.asset = pilot_spritepair_asset;\n    pilot_binding.base_pointer = PILOT_BASE_POINTER;\n    pilot_binding.overlay_pointer = PILOT_OVERLAY_POINTER;\n\n    pilot_x = 150;\n    overlay_animation_frame = 3;\n    crowd_phase = 0;\n\n    /* Slots 0 and 1 are an application-owned, atomically aligned HUD pair. */\n    web64_sprite_renderer_init(&direct_renderer, POINTER_TABLE);\n    web64_sprite_apply_overlay_palette(pilot_spritepair_asset);\n    web64_sprite_render_asset_pair(\n        &direct_renderer, &pilot_binding, 1, 0, 24, 24,\n        0, 0, WEB64_SPRITE_VISIBLE\n    );\n\n    web64_sprite_mux_init(\n        &sprite_mux, sprite_mux_buffer_a, sprite_mux_buffer_b,\n        MUX_CAPACITY, POINTER_TABLE, MUX_OWNED_SLOTS,\n        5, 10, WEB64_SPRITE_MUX_VIDEO_PAL\n    );\n\n    /* Authoritative lowered-import root for the assembly wrapper's fast service. */\n    web64_sprite_mux_irq_service_fast();\n\n    web64_sprite_mux_activate(&sprite_mux);\n    example_submit_frame();\n\n#ifdef WEB64_EXAMPLE_VERIFY\n    /* Synthetic verification publishes the first armed boundary explicitly. */\n    web64_sprite_mux_irq_service();\n    verification_first_x = pilot_x;\n    example_advance_animation();\n    example_submit_frame();\n    for (verification_irq_count = 0; verification_irq_count < 13; verification_irq_count++) {\n        web64_sprite_mux_irq_service();\n    }\n    verification_second_x = pilot_x;\n    verification_complete = 1;\n    return;\n#else\n    /*\n     * The application owns the vector, source acknowledgement, chaining,\n     * game tick, and final RTI. The runtime service only updates its schedule.\n     */\n    example_install_irq();\n    example_advance_animation();\n    observed_tick = frame_tick;\n    while (1) {\n        while (observed_tick == frame_tick) { }\n        observed_tick = frame_tick;\n        /* Advance only after a frame was committed; a busy pending buffer repeats. */\n        if (example_submit_frame()) example_advance_animation();\n    }\n#endif\n}\n",
    "selectedEntryLabel": "auto"
  },
