{
  "kind": "web64.ide.project",
  "version": 4,
  "savedAt": "2026-08-19T11:58:55.418Z",
  "main": {
    "fileName": "main.asm",
    "origin": "$8000",
    "source": "; Web64 IDE Example\n; Name: Sci-Fi Color Map Scroller\n; Description: Smooth bidirectional scrolling of an 80x25 multicolor map with a fixed four-row HUD.\n;\n; The map was imported as bitmap-multicolor data. Its generated video-matrix\n; plane supplies colors 1/2 and Color RAM supplies color 3 for every cell, so\n; text mode cannot reproduce the editor image. This runtime expands the first\n; 21 map rows into two true multicolor bitmap viewports and leaves rows 21-24\n; to a fixed text HUD.\n;\n; One target bitmap row is streamed per frame while fine scrolling advances\n; once every three frames. Color RAM cannot be double-buffered, so each staged\n; row is committed after the VIC-II has latched the old row on its badline.\n; The next top IRQ switches bitmap banks and screen matrices atomically.\n\n.include \"assets/chars/scifi2.inc\"\n\nSCREEN_0 = $0400\nSCREEN_1 = $4400\nBITMAP_0 = $2000\nBITMAP_1 = $6000\nCOLOR_RAM = $d800\nCOLOR_STAGE = $1800\nEXPANDED_ROWS_0 = $b000\nEXPANDED_ROWS_12 = $5000\nEXPANDED_ROWS_18 = $1000\n\nVIC_CONTROL_1 = $d011\nVIC_RASTER = $d012\nVIC_CONTROL_2 = $d016\nVIC_MEMORY = $d018\nVIC_IRQ_STATUS = $d019\nVIC_IRQ_ENABLE = $d01a\nVIC_BORDER = $d020\nVIC_BACKGROUND = $d021\nCIA1_IRQ = $dc0d\nCIA2_IRQ = $dd0d\nVIC_BANK = $dd00\n\nIRQ_VECTOR = $0314\nKERNAL_IRQ_EXIT = $ea81\n\nPLAYFIELD_ROWS = 21\nVIEWPORT_COLUMNS = 40\nMAP_ROW_BYTES = 80\nBITMAP_ROW_BYTES = 320\nEXPANDED_ROW_BYTES = 640\nMAX_CAMERA_X = 40\nHUD_OFFSET = PLAYFIELD_ROWS * VIEWPORT_COLUMNS\n\nBITMAP_D018 = $18\nHUD_D018 = $14\nBITMAP_D011 = $3b\nHUD_D011 = $1b\nBITMAP_D016 = $10\nHUD_D016 = $08\n\nDIRECTION_LEFT = 1\nDIRECTION_RIGHT = 2\n\nBITMAP_SOURCE_PTR = $f3\nSCREEN_SOURCE_PTR = $f5\nCOLOR_SOURCE_PTR = $f7\nBITMAP_DEST_PTR = $f9\nSCREEN_DEST_PTR = $fb\nSTAGE_PTR = $fd\n\n; Four unrolled page routines cover the 840-byte playfield. Row wrappers\n; select a page and an X offset, keeping every copy below the next badline\n; while avoiding 21 separately expanded copies of the same 40-byte kernel.\n.macro copy_color_page source, destination\n    lda source+0,x\n    sta destination+0,x\n    lda source+1,x\n    sta destination+1,x\n    lda source+2,x\n    sta destination+2,x\n    lda source+3,x\n    sta destination+3,x\n    lda source+4,x\n    sta destination+4,x\n    lda source+5,x\n    sta destination+5,x\n    lda source+6,x\n    sta destination+6,x\n    lda source+7,x\n    sta destination+7,x\n    lda source+8,x\n    sta destination+8,x\n    lda source+9,x\n    sta destination+9,x\n    lda source+10,x\n    sta destination+10,x\n    lda source+11,x\n    sta destination+11,x\n    lda source+12,x\n    sta destination+12,x\n    lda source+13,x\n    sta destination+13,x\n    lda source+14,x\n    sta destination+14,x\n    lda source+15,x\n    sta destination+15,x\n    lda source+16,x\n    sta destination+16,x\n    lda source+17,x\n    sta destination+17,x\n    lda source+18,x\n    sta destination+18,x\n    lda source+19,x\n    sta destination+19,x\n    lda source+20,x\n    sta destination+20,x\n    lda source+21,x\n    sta destination+21,x\n    lda source+22,x\n    sta destination+22,x\n    lda source+23,x\n    sta destination+23,x\n    lda source+24,x\n    sta destination+24,x\n    lda source+25,x\n    sta destination+25,x\n    lda source+26,x\n    sta destination+26,x\n    lda source+27,x\n    sta destination+27,x\n    lda source+28,x\n    sta destination+28,x\n    lda source+29,x\n    sta destination+29,x\n    lda source+30,x\n    sta destination+30,x\n    lda source+31,x\n    sta destination+31,x\n    lda source+32,x\n    sta destination+32,x\n    lda source+33,x\n    sta destination+33,x\n    lda source+34,x\n    sta destination+34,x\n    lda source+35,x\n    sta destination+35,x\n    lda source+36,x\n    sta destination+36,x\n    lda source+37,x\n    sta destination+37,x\n    lda source+38,x\n    sta destination+38,x\n    lda source+39,x\n    sta destination+39,x\n.endmacro\n\n.macro wait_raster line\n%%wait:\n    lda VIC_RASTER\n    cmp #line\n    bne %%wait\n.endmacro\n\n.macro write_hud_text text, offset, color\n    ldy #0\n%%next:\n    lda text,y\n    beq %%done\n    and #$3f\n    sta SCREEN_0+HUD_OFFSET+offset,y\n    sta SCREEN_1+HUD_OFFSET+offset,y\n    lda #color\n    sta COLOR_RAM+HUD_OFFSET+offset,y\n    iny\n    bne %%next\n%%done:\n.endmacro\n\nstart:\n    sei\n    lda #0\n    sta VIC_CONTROL_1\n    sta VIC_BORDER\n    sta VIC_BACKGROUND\n    sta frame_ready\n    sta swap_pending\n    sta camera_x\n    sta target_x\n    sta screen_select\n    sta prep_state\n    lda #7\n    sta scroll_fine\n    lda #2\n    sta pixel_delay\n    lda #DIRECTION_RIGHT\n    sta scroll_direction\n\n    ; BASIC is not needed. Keeping HIRAM and CHAREN set leaves KERNAL and I/O\n    ; available while exposing the expansion buffer at $b000.\n    lda $01\n    and #$f8\n    ora #$06\n    sta $01\n\n    jsr expand_world_bitmap\n    jsr prepare_initial_viewport\n    jsr initialize_hud\n    jsr install_raster_irq\n\n    lda #3\n    jsr set_vic_bank\n    lda #BITMAP_D011\n    sta VIC_CONTROL_1\n    lda #BITMAP_D018\n    sta VIC_MEMORY\n    lda scroll_fine\n    ora #BITMAP_D016\n    sta VIC_CONTROL_2\n    cli\n\nmain_loop:\n\tlda #5\n    sta $d020\n    jsr wait_frame\n    lda #2\n    sta $d020\n    jsr begin_target_if_needed\n    jsr prepare_one_row\n    jsr advance_scroll\n    jmp main_loop\n\nwait_frame:\n    lda frame_ready\n    beq wait_frame\n    lda #0\n    sta frame_ready\n    rts\n\nexpand_world_bitmap:\n    lda #<scifimap2_map\n    sta SCREEN_SOURCE_PTR\n    lda #>scifimap2_map\n    sta SCREEN_SOURCE_PTR+1\n    lda #<EXPANDED_ROWS_0\n    sta BITMAP_DEST_PTR\n    lda #>EXPANDED_ROWS_0\n    sta BITMAP_DEST_PTR+1\n    lda #0\n    sta expand_row\nexpand_row_loop:\n    lda expand_row\n    cmp #12\n    bne expand_check_row_18\n    lda #<EXPANDED_ROWS_12\n    sta BITMAP_DEST_PTR\n    lda #>EXPANDED_ROWS_12\n    sta BITMAP_DEST_PTR+1\nexpand_check_row_18:\n    lda expand_row\n    cmp #18\n    bne expand_row_ready\n    lda #<EXPANDED_ROWS_18\n    sta BITMAP_DEST_PTR\n    lda #>EXPANDED_ROWS_18\n    sta BITMAP_DEST_PTR+1\nexpand_row_ready:\n    ldx #MAP_ROW_BYTES\nexpand_cell_loop:\n    ldy #0\n    lda (SCREEN_SOURCE_PTR),y\n    sta glyph_offset\n    lda #0\n    sta glyph_offset+1\n    asl glyph_offset\n    rol glyph_offset+1\n    asl glyph_offset\n    rol glyph_offset+1\n    asl glyph_offset\n    rol glyph_offset+1\n    clc\n    lda glyph_offset\n    adc #<scifi2_chars\n    sta BITMAP_SOURCE_PTR\n    lda glyph_offset+1\n    adc #>scifi2_chars\n    sta BITMAP_SOURCE_PTR+1\n    ldy #0\nexpand_glyph_loop:\n    lda (BITMAP_SOURCE_PTR),y\n    sta (BITMAP_DEST_PTR),y\n    iny\n    cpy #8\n    bne expand_glyph_loop\n    inc SCREEN_SOURCE_PTR\n    bne expand_map_advanced\n    inc SCREEN_SOURCE_PTR+1\nexpand_map_advanced:\n    clc\n    lda BITMAP_DEST_PTR\n    adc #8\n    sta BITMAP_DEST_PTR\n    lda BITMAP_DEST_PTR+1\n    adc #0\n    sta BITMAP_DEST_PTR+1\n    dex\n    bne expand_cell_loop\n    inc expand_row\n    lda expand_row\n    cmp #PLAYFIELD_ROWS\n    bne expand_row_loop\n    rts\n\nprepare_initial_viewport:\n    lda #0\n    sta target_x\n    jsr set_target_sources\n    lda #<BITMAP_0\n    sta BITMAP_DEST_PTR\n    lda #>BITMAP_0\n    sta BITMAP_DEST_PTR+1\n    lda #<SCREEN_0\n    sta SCREEN_DEST_PTR\n    lda #>SCREEN_0\n    sta SCREEN_DEST_PTR+1\n    jsr reset_stage_pointer\n    lda #0\n    sta prep_row\n    lda #PLAYFIELD_ROWS\n    sta prep_rows\n    lda #1\n    sta prep_state\nprepare_initial_rows:\n    jsr prepare_one_row\n    lda prep_state\n    cmp #2\n    bne prepare_initial_rows\n    jsr copy_all_color_rows\n    lda #0\n    sta prep_state\n    rts\n\ninitialize_hud:\n    ldx #0\n    lda #$20\ninitialize_hud_cells:\n    sta SCREEN_0+HUD_OFFSET,x\n    inx\n    cpx #160\n    bne initialize_hud_cells\n    ldx #0\n    lda #$0b\ninitialize_hud_colors:\n    sta COLOR_RAM+HUD_OFFSET,x\n    inx\n    cpx #160\n    bne initialize_hud_colors\n    write_hud_text hud_line_0, 4, $0f\n    write_hud_text hud_line_1, 5+40, $03\n    write_hud_text hud_line_2, 3+80, $0e\n    write_hud_text hud_line_3, 7+120, $0b\n    rts\n\ninstall_raster_irq:\n    lda #$7f\n    sta CIA1_IRQ\n    sta CIA2_IRQ\n    lda CIA1_IRQ\n    lda CIA2_IRQ\n    lda #<raster_irq\n    sta IRQ_VECTOR\n    lda #>raster_irq\n    sta IRQ_VECTOR+1\n    lda #0\n    sta irq_phase\n    sta VIC_RASTER\n    lda #1\n    sta VIC_IRQ_STATUS\n    sta VIC_IRQ_ENABLE\n    rts\n\nset_vic_bank:\n    and #3\n    sta bank_bits\n    lda VIC_BANK\n    and #$fc\n    ora bank_bits\n    sta VIC_BANK\n    rts\n\nraster_irq:\n    lda #1\n    sta VIC_IRQ_STATUS\n    lda irq_phase\n    beq raster_top\nraster_wait_hud:\n    lda VIC_RASTER\n    cmp #$da\n    bne raster_wait_hud\n    lda #3\n    jsr set_vic_bank\n    lda #HUD_D011\n    sta VIC_CONTROL_1\n    lda #HUD_D016\n    sta VIC_CONTROL_2\n    lda #HUD_D018\n    sta VIC_MEMORY\n    lda #0\n    sta irq_phase\n    sta VIC_RASTER\n    jmp KERNAL_IRQ_EXIT\n\nraster_top:\n    lda swap_pending\n    beq raster_no_swap\n    lda #0\n    sta swap_pending\n    sta prep_state\n    lda target_x\n    sta camera_x\n    lda screen_select\n    eor #1\n    sta screen_select\n    lda scroll_direction\n    cmp #DIRECTION_LEFT\n    beq raster_swap_left\n    lda #7\n    bne raster_store_swap_fine\nraster_swap_left:\n    lda #0\nraster_store_swap_fine:\n    sta scroll_fine\n    lda #2\n    sta pixel_delay\nraster_no_swap:\n    lda screen_select\n    beq raster_bank_0\n    lda #2\n    bne raster_bank_ready\nraster_bank_0:\n    lda #3\nraster_bank_ready:\n    jsr set_vic_bank\n    lda #BITMAP_D011\n    sta VIC_CONTROL_1\n    lda scroll_fine\n    ora #BITMAP_D016\n    sta VIC_CONTROL_2\n    lda #BITMAP_D018\n    sta VIC_MEMORY\n    lda #1\n    sta frame_ready\n    sta irq_phase\n    lda #$d9\n    sta VIC_RASTER\n    jmp KERNAL_IRQ_EXIT\n\nbegin_target_if_needed:\n    lda prep_state\n    beq begin_choose_target\n    rts\nbegin_choose_target:\n    lda scroll_direction\n    cmp #DIRECTION_LEFT\n    beq begin_left_target\n    lda camera_x\n    cmp #MAX_CAMERA_X\n    bcc begin_right_forward\n    lda #MAX_CAMERA_X-1\n    bne begin_target_ready\nbegin_right_forward:\n    clc\n    adc #1\n    bne begin_target_ready\nbegin_left_target:\n    lda camera_x\n    bne begin_left_forward\n    lda #1\n    bne begin_target_ready\nbegin_left_forward:\n    sec\n    sbc #1\nbegin_target_ready:\n    sta target_x\n    jsr set_target_sources\n    lda screen_select\n    beq begin_hidden_bitmap_1\n    lda #<BITMAP_0\n    sta BITMAP_DEST_PTR\n    lda #>BITMAP_0\n    sta BITMAP_DEST_PTR+1\n    lda #<SCREEN_0\n    sta SCREEN_DEST_PTR\n    lda #>SCREEN_0\n    sta SCREEN_DEST_PTR+1\n    jmp begin_destinations_ready\nbegin_hidden_bitmap_1:\n    lda #<BITMAP_1\n    sta BITMAP_DEST_PTR\n    lda #>BITMAP_1\n    sta BITMAP_DEST_PTR+1\n    lda #<SCREEN_1\n    sta SCREEN_DEST_PTR\n    lda #>SCREEN_1\n    sta SCREEN_DEST_PTR+1\nbegin_destinations_ready:\n    jsr reset_stage_pointer\n    lda #0\n    sta prep_row\n    lda #PLAYFIELD_ROWS\n    sta prep_rows\n    lda #1\n    sta prep_state\n    rts\n\nset_target_sources:\n    lda target_x\n    asl\n    asl\n    asl\n    sta target_bitmap_offset\n    lda #0\n    rol\n    sta target_bitmap_offset+1\n    clc\n    lda #<EXPANDED_ROWS_0\n    adc target_bitmap_offset\n    sta BITMAP_SOURCE_PTR\n    lda #>EXPANDED_ROWS_0\n    adc target_bitmap_offset+1\n    sta BITMAP_SOURCE_PTR+1\n    clc\n    lda #<scifimap2_video_matrix\n    adc target_x\n    sta SCREEN_SOURCE_PTR\n    lda #>scifimap2_video_matrix\n    adc #0\n    sta SCREEN_SOURCE_PTR+1\n    clc\n    lda #<scifimap2_color_ram\n    adc target_x\n    sta COLOR_SOURCE_PTR\n    lda #>scifimap2_color_ram\n    adc #0\n    sta COLOR_SOURCE_PTR+1\n    rts\n\nreset_stage_pointer:\n    lda #<COLOR_STAGE\n    sta STAGE_PTR\n    lda #>COLOR_STAGE\n    sta STAGE_PTR+1\n    rts\n\nprepare_one_row:\n    lda prep_state\n    cmp #1\n    beq prepare_row_start\n    rts\nprepare_row_start:\n    ldy #0\nprepare_bitmap_page:\n    lda (BITMAP_SOURCE_PTR),y\n    sta (BITMAP_DEST_PTR),y\n    iny\n    bne prepare_bitmap_page\n    inc BITMAP_SOURCE_PTR+1\n    inc BITMAP_DEST_PTR+1\n    ldy #0\nprepare_bitmap_tail:\n    lda (BITMAP_SOURCE_PTR),y\n    sta (BITMAP_DEST_PTR),y\n    iny\n    cpy #64\n    bne prepare_bitmap_tail\n\n    ldy #0\nprepare_attribute_cell:\n    lda (SCREEN_SOURCE_PTR),y\n    sta (SCREEN_DEST_PTR),y\n    lda (COLOR_SOURCE_PTR),y\n    and #$0f\n    sta (STAGE_PTR),y\n    iny\n    cpy #VIEWPORT_COLUMNS\n    bne prepare_attribute_cell\n\n    ; Source already advanced 256 bytes; add 384 to reach the next 640-byte row.\n    clc\n    lda BITMAP_SOURCE_PTR\n    adc #$80\n    sta BITMAP_SOURCE_PTR\n    lda BITMAP_SOURCE_PTR+1\n    adc #1\n    sta BITMAP_SOURCE_PTR+1\n    ; Destination already advanced 256 bytes; add 64 to reach the next bitmap row.\n    clc\n    lda BITMAP_DEST_PTR\n    adc #64\n    sta BITMAP_DEST_PTR\n    lda BITMAP_DEST_PTR+1\n    adc #0\n    sta BITMAP_DEST_PTR+1\n    clc\n    lda SCREEN_SOURCE_PTR\n    adc #MAP_ROW_BYTES\n    sta SCREEN_SOURCE_PTR\n    lda SCREEN_SOURCE_PTR+1\n    adc #0\n    sta SCREEN_SOURCE_PTR+1\n    clc\n    lda COLOR_SOURCE_PTR\n    adc #MAP_ROW_BYTES\n    sta COLOR_SOURCE_PTR\n    lda COLOR_SOURCE_PTR+1\n    adc #0\n    sta COLOR_SOURCE_PTR+1\n    clc\n    lda SCREEN_DEST_PTR\n    adc #VIEWPORT_COLUMNS\n    sta SCREEN_DEST_PTR\n    lda SCREEN_DEST_PTR+1\n    adc #0\n    sta SCREEN_DEST_PTR+1\n    clc\n    lda STAGE_PTR\n    adc #VIEWPORT_COLUMNS\n    sta STAGE_PTR\n    lda STAGE_PTR+1\n    adc #0\n    sta STAGE_PTR+1\n\n    inc prep_row\n    lda prep_row\n    cmp #12\n    bne prepare_check_row_18\n    jsr set_bitmap_source_rows_12\nprepare_check_row_18:\n    lda prep_row\n    cmp #18\n    bne prepare_row_count\n    jsr set_bitmap_source_rows_18\nprepare_row_count:\n    dec prep_rows\n    bne prepare_row_done\n    lda #2\n    sta prep_state\nprepare_row_done:\n    rts\n\nset_bitmap_source_rows_12:\n    clc\n    lda #<EXPANDED_ROWS_12\n    adc target_bitmap_offset\n    sta BITMAP_SOURCE_PTR\n    lda #>EXPANDED_ROWS_12\n    adc target_bitmap_offset+1\n    sta BITMAP_SOURCE_PTR+1\n    rts\n\nset_bitmap_source_rows_18:\n    clc\n    lda #<EXPANDED_ROWS_18\n    adc target_bitmap_offset\n    sta BITMAP_SOURCE_PTR\n    lda #>EXPANDED_ROWS_18\n    adc target_bitmap_offset+1\n    sta BITMAP_SOURCE_PTR+1\n    rts\n\nadvance_scroll:\n    lda scroll_direction\n    cmp #DIRECTION_LEFT\n    beq advance_left\nadvance_right:\n    lda camera_x\n    cmp #MAX_CAMERA_X\n    beq advance_right_edge\n    lda scroll_fine\n    beq advance_commit\n    jsr wait_pixel_step\n    bcc advance_done\n    dec scroll_fine\n    rts\nadvance_right_edge:\n    lda scroll_fine\n    beq reverse_to_left\n    jsr wait_pixel_step\n    bcc advance_done\n    dec scroll_fine\n    rts\nreverse_to_left:\n    lda #DIRECTION_LEFT\n    sta scroll_direction\n    lda #1\n    sta scroll_fine\n    lda #2\n    sta pixel_delay\n    rts\n\nadvance_left:\n    lda camera_x\n    beq advance_left_edge\n    lda scroll_fine\n    cmp #7\n    beq advance_commit\n    jsr wait_pixel_step\n    bcc advance_done\n    inc scroll_fine\n    rts\nadvance_left_edge:\n    lda scroll_fine\n    cmp #7\n    beq reverse_to_right\n    jsr wait_pixel_step\n    bcc advance_done\n    inc scroll_fine\n    rts\nreverse_to_right:\n    lda #DIRECTION_RIGHT\n    sta scroll_direction\n    lda #6\n    sta scroll_fine\n    lda #2\n    sta pixel_delay\n    rts\n\nwait_pixel_step:\n    lda pixel_delay\n    beq pixel_step_ready\n    dec pixel_delay\n    clc\n    rts\npixel_step_ready:\n    lda #2\n    sta pixel_delay\n    sec\n    rts\n\nadvance_commit:\n    lda prep_state\n    cmp #2\n    bne advance_done\n    jsr copy_target_colors_during_scanout\n    lda #1\n    sta swap_pending\nadvance_done:\n    rts\n\n; The raster waits occur immediately after each playfield badline. The VIC-II\n; has already latched that row's old Color RAM values, so replacing the row is\n; invisible until the top IRQ activates the prepared screen on the next frame.\ncopy_target_colors_during_scanout:\n    wait_raster $34\n    jsr copy_color_row_0\n    wait_raster $3c\n    jsr copy_color_row_1\n    wait_raster $44\n    jsr copy_color_row_2\n    wait_raster $4c\n    jsr copy_color_row_3\n    wait_raster $54\n    jsr copy_color_row_4\n    wait_raster $5c\n    jsr copy_color_row_5\n    wait_raster $64\n    jsr copy_color_row_6\n    wait_raster $6c\n    jsr copy_color_row_7\n    wait_raster $74\n    jsr copy_color_row_8\n    wait_raster $7c\n    jsr copy_color_row_9\n    wait_raster $84\n    jsr copy_color_row_10\n    wait_raster $8c\n    jsr copy_color_row_11\n    wait_raster $94\n    jsr copy_color_row_12\n    wait_raster $9c\n    jsr copy_color_row_13\n    wait_raster $a4\n    jsr copy_color_row_14\n    wait_raster $ac\n    jsr copy_color_row_15\n    wait_raster $b4\n    jsr copy_color_row_16\n    wait_raster $bc\n    jsr copy_color_row_17\n    wait_raster $c4\n    jsr copy_color_row_18\n    wait_raster $cc\n    jsr copy_color_row_19\n    wait_raster $d4\n    jsr copy_color_row_20\n    rts\n\ncopy_all_color_rows:\n    jsr copy_color_row_0\n    jsr copy_color_row_1\n    jsr copy_color_row_2\n    jsr copy_color_row_3\n    jsr copy_color_row_4\n    jsr copy_color_row_5\n    jsr copy_color_row_6\n    jsr copy_color_row_7\n    jsr copy_color_row_8\n    jsr copy_color_row_9\n    jsr copy_color_row_10\n    jsr copy_color_row_11\n    jsr copy_color_row_12\n    jsr copy_color_row_13\n    jsr copy_color_row_14\n    jsr copy_color_row_15\n    jsr copy_color_row_16\n    jsr copy_color_row_17\n    jsr copy_color_row_18\n    jsr copy_color_row_19\n    jsr copy_color_row_20\n    rts\n\ncopy_color_row_0:\n    ldx #$00\n    jmp copy_color_page_0\ncopy_color_row_1:\n    ldx #$28\n    jmp copy_color_page_0\ncopy_color_row_2:\n    ldx #$50\n    jmp copy_color_page_0\ncopy_color_row_3:\n    ldx #$78\n    jmp copy_color_page_0\ncopy_color_row_4:\n    ldx #$a0\n    jmp copy_color_page_0\ncopy_color_row_5:\n    ldx #$c8\n    jmp copy_color_page_0\ncopy_color_row_6:\n    ldx #$f0\n    jmp copy_color_page_0\ncopy_color_row_7:\n    ldx #$18\n    jmp copy_color_page_1\ncopy_color_row_8:\n    ldx #$40\n    jmp copy_color_page_1\ncopy_color_row_9:\n    ldx #$68\n    jmp copy_color_page_1\ncopy_color_row_10:\n    ldx #$90\n    jmp copy_color_page_1\ncopy_color_row_11:\n    ldx #$b8\n    jmp copy_color_page_1\ncopy_color_row_12:\n    ldx #$e0\n    jmp copy_color_page_1\ncopy_color_row_13:\n    ldx #$08\n    jmp copy_color_page_2\ncopy_color_row_14:\n    ldx #$30\n    jmp copy_color_page_2\ncopy_color_row_15:\n    ldx #$58\n    jmp copy_color_page_2\ncopy_color_row_16:\n    ldx #$80\n    jmp copy_color_page_2\ncopy_color_row_17:\n    ldx #$a8\n    jmp copy_color_page_2\ncopy_color_row_18:\n    ldx #$d0\n    jmp copy_color_page_2\ncopy_color_row_19:\n    ldx #$f8\n    jmp copy_color_page_2\ncopy_color_row_20:\n    ldx #$20\n    jmp copy_color_page_3\n\ncopy_color_page_0:\n    copy_color_page COLOR_STAGE+$000, COLOR_RAM+$000\n    rts\ncopy_color_page_1:\n    copy_color_page COLOR_STAGE+$100, COLOR_RAM+$100\n    rts\ncopy_color_page_2:\n    copy_color_page COLOR_STAGE+$200, COLOR_RAM+$200\n    rts\ncopy_color_page_3:\n    copy_color_page COLOR_STAGE+$300, COLOR_RAM+$300\n    rts\nframe_ready: .byte 0\nswap_pending: .byte 0\nirq_phase: .byte 0\ncamera_x: .byte 0\ntarget_x: .byte 0\nscreen_select: .byte 0\nscroll_fine: .byte 7\nscroll_direction: .byte DIRECTION_RIGHT\nprep_state: .byte 0\nprep_rows: .byte 0\nprep_row: .byte 0\npixel_delay: .byte 2\nexpand_row: .byte 0\nglyph_offset: .word 0\ntarget_bitmap_offset: .word 0\nbank_bits: .byte 0\n\nhud_line_0: .text \"WEB64 SCI-FI COLOR SCROLLER\"\n    .byte 0\nhud_line_1: .text \"80X25 MAP / 21-ROW PLAYFIELD\"\n    .byte 0\nhud_line_2: .text \"STAGED SCREEN + EXACT COLOR RAM\"\n    .byte 0\nhud_line_3: .text \"FOUR-ROW FIXED HUD\"\n    .byte 0\n\n; Native Web64 assets remain the single source of truth.\