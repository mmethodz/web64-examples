      "source": "{\n  \"schema\": \"web64.ide.trajectoryAsset\",\n  \"version\": 1,\n  \"id\": \"trajectory-patterns-shared-loop\",\n  \"name\": \"Shared Loop\",\n  \"points\": [\n    {\n      \"id\": \"shared-loop-point-1\",\n      \"x\": 0,\n      \"y\": 0\n    },\n    {\n      \"id\": \"shared-loop-point-2\",\n      \"x\": 48,\n      \"y\": 0,\n      \"duration\": 32\n    },\n    {\n      \"id\": \"shared-loop-point-3\",\n      \"x\": 64,\n      \"y\": 16,\n      \"duration\": 17\n    },\n    {\n      \"id\": \"shared-loop-point-4\",\n      \"x\": 48,\n      \"y\": 32,\n      \"duration\": 23\n    },\n    {\n      \"id\": \"shared-loop-point-5\",\n      \"x\": 0,\n      \"y\": 32,\n      \"duration\": 32\n    },\n    {\n      \"id\": \"shared-loop-point-6\",\n      \"x\": -16,\n      \"y\": 16,\n      \"duration\": 17\n    },\n    {\n      \"id\": \"shared-loop-point-7\",\n      \"x\": 0,\n      \"y\": 0,\n      \"duration\": 23\n    },\n    {\n      \"id\": \"shared-loop-point-8\",\n      \"x\": 0,\n      \"y\": 6,\n      \"duration\": 31\n    },\n    {\n      \"id\": \"shared-loop-point-9\",\n      \"x\": 0,\n      \"y\": 0,\n      \"duration\": 29\n    }\n  ],\n  \"runtimeDefaults\": {\n    \"loop\": true,\n    \"pingPong\": false,\n    \"reverse\": false,\n    \"negateX\": false,\n    \"negateY\": false\n  },\n  \"authoring\": {\n    \"anchor\": {\n      \"x\": 58,\n      \"y\": 84\n    },\n    \"mapBackdrop\": null,\n    \"appearancePreview\": null,\n    \"grid\": {\n      \"visible\": true,\n      \"snap\": true,\n      \"spacingX\": 8,\n      \"spacingY\": 8,\n      \"preset\": \"character\"\n    },\n    \"storedView\": {\n      \"centerX\": 0,\n      \"centerY\": 0,\n      \"zoom\": 1\n    }\n  }\n}\n"
