    "origin": "$6000",
    "source": "#include <stdint.h>\n#include <c64.h>\n#include \"include/game.h\"\n\nvoid asm_setup_game(void);\nvoid asm_wait_and_render(void);\nvoid asm_read_material(void);\nvoid asm_erase_cell(void);\nvoid asm_count_eggs(void);\n\n#define STATE_WALK 0\n#define STATE_CLIMB 1\n#define STATE_FLY 2\n\n#define FACING_RIGHT 0\n#define FACING_LEFT 1\n\n#define FIXED_SCALE 16\n#define PLAYER_WIDTH 24\n#define PLAYER_HEIGHT 21\n#define PLAYER_MAX_X 296\n#define START_X 24\n#define START_Y 147\n\n#define WALK_ACCEL 2\n#define WALK_BRAKE 1\n#define WALK_MAX_SPEED 24\n#define FALL_ACCEL 2\n#define FALL_MAX_SPEED 32\n#define CLIMB_SPEED 16\n#define ANIMATION_DELAY 5\n\nint16_t player_x = START_X * FIXED_SCALE;\nint16_t player_y = START_Y * FIXED_SCALE;\nint16_t player_dx = 0;\nint16_t player_dy = 0;\nuint16_t player_screen_x = START_X + 24;\nuint8_t player_screen_y = START_Y + 50;\nuint8_t player_frame = 0;\n\nuint8_t player_state = STATE_WALK;\nuint8_t player_facing = FACING_RIGHT;\nuint8_t joy_now = JOY_RELEASED_MASK;\nuint8_t animation_delay = 0;\nuint8_t animation_phase = 0;\nuint8_t turn_frames = 0;\nuint8_t eggs_remaining = 0;\nuint8_t game_won = 0;\nuint16_t map_cell_index = 0;\nuint8_t map_cell_column = 0;\nuint8_t map_cell_row = 0;\nuint8_t map_cell_value = 0;\nuint8_t map_cell_character = 0;\n\nstatic uint8_t material_at_cell(uint8_t column, uint8_t row) {\n    map_cell_column = column;\n    map_cell_row = row;\n    asm_read_material();\n    return map_cell_value;\n}\n\nstatic uint8_t material_at(uint16_t pixel_x, uint16_t pixel_y) {\n    uint8_t column;\n    uint8_t row;\n    if (pixel_x >= MAP_PIXEL_WIDTH) {\n        return 0;\n    }\n    if (pixel_y >= MAP_PIXEL_HEIGHT) {\n        return 0;\n    }\n    column = (uint8_t)(pixel_x / 8);\n    row = (uint8_t)(pixel_y / 8);\n    return material_at_cell(column, row);\n}\n\nstatic uint8_t is_floor(uint8_t material) {\n    if (material == MAT_PLATFORM) {\n        return 1;\n    }\n    if (material == MAT_LADDER) {\n        return 1;\n    }\n    return 0;\n}\n\nstatic uint16_t player_pixel_x(void) {\n    return (uint16_t)(player_x / FIXED_SCALE);\n}\n\nstatic uint8_t player_pixel_y(void) {\n    return (uint8_t)(player_y / FIXED_SCALE);\n}\n\nstatic uint8_t ladder_column(uint8_t probe_y) {\n    uint8_t first;\n    uint8_t last;\n    uint8_t column;\n    uint8_t row;\n    uint16_t px;\n    px = player_pixel_x();\n    first = (uint8_t)((px + 4) / 8);\n    last = (uint8_t)((px + 19) / 8);\n    row = (uint8_t)(probe_y / 8);\n    if (row >= MAP_HEIGHT) {\n        return 255;\n    }\n    for (column = first; column <= last; column = column + 1) {\n        if (column >= MAP_WIDTH) {\n            return 255;\n        }\n        if (material_at_cell(column, row) == MAT_LADDER) {\n            if (column != 0) {\n                if (material_at_cell(column - 1, row) == MAT_LADDER) {\n                    return column - 1;\n                }\n            }\n            return column;\n        }\n    }\n    return 255;\n}\n\nstatic void enter_ladder(uint8_t column) {\n    int16_t snapped_x;\n    snapped_x = ((int16_t)column * 8) - 4;\n    if (snapped_x < 0) {\n        snapped_x = 0;\n    }\n    if (snapped_x > PLAYER_MAX_X) {\n        snapped_x = PLAYER_MAX_X;\n    }\n    player_x = snapped_x * FIXED_SCALE;\n    player_dx = 0;\n    player_dy = 0;\n    player_state = STATE_CLIMB;\n    animation_delay = 0;\n    animation_phase = 0;\n}\n\nstatic uint8_t try_enter_ladder(void) {\n    uint8_t column;\n    uint8_t py;\n    py = player_pixel_y();\n    if (((joy_now & JOY_UP) == 0) && ((joy_now & JOY_DOWN) != 0)) {\n        column = ladder_column(py + 19);\n        if (column != 255) {\n            enter_ladder(column);\n            return 1;\n        }\n    }\n    if (((joy_now & JOY_DOWN) == 0) && ((joy_now & JOY_UP) != 0)) {\n        column = ladder_column(py + 22);\n        if (column != 255) {\n            enter_ladder(column);\n            return 1;\n        }\n    }\n    return 0;\n}\n\nstatic void update_facing(void) {\n    uint8_t next_facing;\n    if (((joy_now & JOY_LEFT) == 0) && ((joy_now & JOY_RIGHT) != 0)) {\n        next_facing = FACING_LEFT;\n    } else if (((joy_now & JOY_RIGHT) == 0) && ((joy_now & JOY_LEFT) != 0)) {\n        next_facing = FACING_RIGHT;\n    } else {\n        return;\n    }\n    if (next_facing != player_facing) {\n        player_facing = next_facing;\n        turn_frames = 2;\n        animation_delay = 0;\n    }\n}\n\nstatic void update_horizontal_velocity(void) {\n    if (((joy_now & JOY_LEFT) == 0) && ((joy_now & JOY_RIGHT) != 0)) {\n        player_dx = player_dx - WALK_ACCEL;\n        if (player_dx < -WALK_MAX_SPEED) {\n            player_dx = -WALK_MAX_SPEED;\n        }\n        return;\n    }\n    if (((joy_now & JOY_RIGHT) == 0) && ((joy_now & JOY_LEFT) != 0)) {\n        player_dx = player_dx + WALK_ACCEL;\n        if (player_dx > WALK_MAX_SPEED) {\n            player_dx = WALK_MAX_SPEED;\n        }\n        return;\n    }\n    if (player_dx > 0) {\n        player_dx = player_dx - WALK_BRAKE;\n        return;\n    }\n    if (player_dx < 0) {\n        player_dx = player_dx + WALK_BRAKE;\n    }\n}\n\nstatic void apply_horizontal_motion(void) {\n    player_x = player_x + player_dx;\n    if (player_x < 0) {\n        player_x = 0;\n        player_dx = 0;\n    }\n    if (player_x > (PLAYER_MAX_X * FIXED_SCALE)) {\n        player_x = PLAYER_MAX_X * FIXED_SCALE;\n        player_dx = 0;\n    }\n}\n\nstatic void update_walk(void) {\n    uint16_t px;\n    uint8_t py;\n    update_horizontal_velocity();\n    apply_horizontal_motion();\n    px = player_pixel_x();\n    py = player_pixel_y();\n    if (is_floor(material_at(px + 12, py + PLAYER_HEIGHT)) == 0) {\n        player_state = STATE_FLY;\n        player_dy = 0;\n    }\n}\n\nstatic void update_fly(void) {\n    uint16_t px;\n    uint8_t old_bottom;\n    uint8_t new_bottom;\n    uint8_t floor_y;\n    uint8_t material;\n    update_horizontal_velocity();\n    apply_horizontal_motion();\n    old_bottom = player_pixel_y() + PLAYER_HEIGHT - 1;\n    player_dy = player_dy + FALL_ACCEL;\n    if (player_dy > FALL_MAX_SPEED) {\n        player_dy = FALL_MAX_SPEED;\n    }\n    player_y = player_y + player_dy;\n    new_bottom = player_pixel_y() + PLAYER_HEIGHT - 1;\n    px = player_pixel_x();\n    floor_y = (uint8_t)((new_bottom / 8) * 8);\n    material = material_at(px + 12, floor_y);\n    if ((is_floor(material) != 0) && (old_bottom < floor_y)) {\n        player_y = ((int16_t)floor_y - PLAYER_HEIGHT) * FIXED_SCALE;\n        player_dy = 0;\n        player_state = STATE_WALK;\n    }\n}\n\nstatic void update_climb(void) {\n    uint16_t px;\n    uint8_t py;\n    uint8_t foot_y;\n    uint8_t here;\n    uint8_t above;\n    if (((joy_now & JOY_UP) == 0) && ((joy_now & JOY_DOWN) != 0)) {\n        player_y = player_y - CLIMB_SPEED;\n        py = player_pixel_y();\n        foot_y = py + PLAYER_HEIGHT;\n        px = player_pixel_x();\n        here = material_at(px + 12, foot_y);\n        above = material_at(px + 12, foot_y - 1);\n        if (((foot_y & 7) == 0) && (is_floor(here) != 0) && (above != MAT_LADDER)) {\n            player_state = STATE_WALK;\n            player_y = ((int16_t)foot_y - PLAYER_HEIGHT) * FIXED_SCALE;\n        }\n        return;\n    }\n    if (((joy_now & JOY_DOWN) == 0) && ((joy_now & JOY_UP) != 0)) {\n        player_y = player_y + CLIMB_SPEED;\n        py = player_pixel_y();\n        foot_y = py + PLAYER_HEIGHT;\n        px = player_pixel_x();\n        here = material_at(px + 12, foot_y);\n        if (((foot_y & 7) == 0) && (here == MAT_PLATFORM)) {\n            player_state = STATE_WALK;\n            player_y = ((int16_t)foot_y - PLAYER_HEIGHT) * FIXED_SCALE;\n        }\n    }\n}\n\nstatic uint8_t background_character(uint8_t row) {\n    if (row == 0) {\n        return 14;\n    }\n    if (row == 1) {\n        return 4;\n    }\n    if (row == 2) {\n        return 13;\n    }\n    return 0;\n}\n\nstatic void erase_egg(uint8_t egg_column, uint8_t egg_row) {\n    uint8_t column;\n    uint8_t row;\n    uint8_t character;\n    for (row = egg_row; row < egg_row + 2; row = row + 1) {\n        character = background_character(row);\n        for (column = egg_column; column < egg_column + 2; column = column + 1) {\n            map_cell_column = column;\n            map_cell_row = row;\n            map_cell_character = character;\n            asm_erase_cell();\n        }\n    }\n    if (eggs_remaining != 0) {\n        eggs_remaining = eggs_remaining - 1;\n    }\n    if (eggs_remaining == 0) {\n        game_won = 1;\n        VIC->border_color = COLOR_YELLOW;\n    }\n}\n\nstatic void collect_egg(void) {\n    uint8_t first_column;\n    uint8_t last_column;\n    uint8_t first_row;\n    uint8_t last_row;\n    uint8_t column;\n    uint8_t row;\n    uint8_t egg_column;\n    uint8_t egg_row;\n    uint16_t px;\n    uint8_t py;\n    px = player_pixel_x();\n    py = player_pixel_y();\n    first_column = (uint8_t)((px + 3) / 8);\n    last_column = (uint8_t)((px + 20) / 8);\n    first_row = (uint8_t)((py + 2) / 8);\n    last_row = (uint8_t)((py + 19) / 8);\n    for (row = first_row; row <= last_row; row = row + 1) {\n        if (row >= MAP_HEIGHT) {\n            return;\n        }\n        for (column = first_column; column <= last_column; column = column + 1) {\n            if (column >= MAP_WIDTH) {\n                return;\n            }\n            if (material_at_cell(column, row) == MAT_EGG) {\n                egg_column = column;\n                egg_row = row;\n                if (egg_column != 0) {\n                    if (material_at_cell(egg_column - 1, egg_row) == MAT_EGG) {\n                        egg_column = egg_column - 1;\n                    }\n                }\n                if (egg_row != 0) {\n                    if (material_at_cell(egg_column, egg_row - 1) == MAT_EGG) {\n                        egg_row = egg_row - 1;\n                    }\n                }\n                erase_egg(egg_column, egg_row);\n                return;\n            }\n        }\n    }\n}\n\nstatic void count_eggs(void) {\n    asm_count_eggs();\n}\n\nstatic uint8_t animation_is_moving(void) {\n    if (player_state == STATE_FLY) {\n        return 1;\n    }\n    if (player_state == STATE_CLIMB) {\n        if (((joy_now & JOY_UP) == 0) || ((joy_now & JOY_DOWN) == 0)) {\n            return 1;\n        }\n        return 0;\n    }\n    if (player_dx != 0) {\n        return 1;\n    }\n    return 0;\n}\n\nstatic void update_animation(void) {\n    uint8_t base_frame;\n    if (turn_frames != 0) {\n        player_frame = 9;\n        turn_frames = turn_frames - 1;\n        return;\n    }\n    if (animation_is_moving() != 0) {\n        animation_delay = animation_delay + 1;\n        if (animation_delay >= ANIMATION_DELAY) {\n            animation_delay = 0;\n            animation_phase = animation_phase ^ 1;\n        }\n    } else {\n        animation_delay = 0;\n        animation_phase = 0;\n    }\n    if (player_state == STATE_CLIMB) {\n        player_frame = 8 + animation_phase;\n        return;\n    }\n    if (player_state == STATE_FLY) {\n        if (player_facing == FACING_LEFT) {\n            base_frame = 6;\n        } else {\n            base_frame = 2;\n        }\n    } else {\n        if (player_facing == FACING_LEFT) {\n            base_frame = 4;\n        } else {\n            base_frame = 0;\n        }\n    }\n    player_frame = base_frame + animation_phase;\n}\n\nstatic void update_render_position(void) {\n    player_screen_x = (uint16_t)(player_x / FIXED_SCALE) + 24;\n    player_screen_y = (uint8_t)(player_y / FIXED_SCALE) + 50;\n}\n\nstatic void update(void) {\n    joy_now = *(uint8_t*)JOYPORT_2;\n    update_facing();\n    if (player_state == STATE_CLIMB) {\n        update_climb();\n    } else if (try_enter_ladder() == 0) {\n        if (player_state == STATE_WALK) {\n            update_walk();\n        } else {\n            update_fly();\n        }\n    }\n    collect_egg();\n    update_animation();\n    update_render_position();\n}\n\nvoid main(void) {\n    asm_setup_game();\n    count_eggs();\n    update_render_position();\n    while (1) {\n        update();\n        asm_wait_and_render();\n    }\n}\n",
