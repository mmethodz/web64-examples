      "path": "include/game.h",
      "name": "game.h",
      "kind": "source",
      "source": "#ifndef EGG_HUNT_GAME_H\n#define EGG_HUNT_GAME_H\n\n#define MAT_PLATFORM 1\n#define MAT_LADDER 2\n#define MAT_EGG 3\n\n#define MAP_WIDTH 40\n#define MAP_HEIGHT 22\n#define MAP_PIXEL_WIDTH 320\n#define MAP_PIXEL_HEIGHT 176\n#define BACKGROUND_COLOR 9\n\n#endif\n"
    },
    {
      "path": "src/render.asm",
      "name": "render.asm",
      "kind": "source",
      "source": "; Egg Hunt video setup and frame renderer.\n\nSCREEN_RAM = $0400\nCOLOR_RAM = $d800\nVIC_SPRITE_X = $d000\nVIC_SPRITE_Y = $d001\nVIC_SPRITE_X_MSB = $d010\nVIC_CONTROL_1 = $d011\nVIC_CONTROL_2 = $d016\nVIC_MEMORY = $d018\nVIC_BORDER = $d020\nVIC_BACKGROUND = $d021\nVIC_MULTICOLOR_1 = $d022\nVIC_MULTICOLOR_2 = $d023\nVIC_SPRITE_ENABLE = $d015\nVIC_SPRITE_PRIORITY = $d01b\nVIC_SPRITE_MULTICOLOR = $d01c\nVIC_SPRITE_X_EXPAND = $d01d\nVIC_SPRITE_Y_EXPAND = $d017\nVIC_SPRITE_MC_0 = $d025\nVIC_SPRITE_MC_1 = $d026\nVIC_SPRITE_COLOR = $d027\nSPRITE_POINTER_0 = $07f8\nRASTER = $d012\n\n; The authored multicolor character map is expanded to a bitmap at startup so\n; all four bits of its per-cell colors match the editor preview.\nBITMAP_DEST = $2000\nSPRITE_DEST = $0800\nSPRITE_POINTER = SPRITE_DEST / 64\n\nasm_setup_game:\n    txa\n    pha\n    tya\n    pha\n    sei\n    lda #$08\n    sta VIC_BORDER\n    sta VIC_BACKGROUND\n    lda #$00\n    sta VIC_MULTICOLOR_1\n    lda #$01\n    sta VIC_MULTICOLOR_2\n    lda #%00011000\n    sta VIC_CONTROL_2\n    sta VIC_MEMORY\n    lda VIC_CONTROL_1\n    ora #%00100000\n    sta VIC_CONTROL_1\n\n    jsr build_bitmap_map\n\n    ldx #$00\ncopy_sprite_pages:\n    lda _sprite_data+$000,x\n    sta SPRITE_DEST+$000,x\n    lda _sprite_data+$100,x\n    sta SPRITE_DEST+$100,x\n    inx\n    bne copy_sprite_pages\n    ldx #$7f\ncopy_sprite_tail:\n    lda _sprite_data+$200,x\n    sta SPRITE_DEST+$200,x\n    dex\n    bpl copy_sprite_tail\n\n    ldx #$00\ncopy_map_pages:\n    lda #$01\n    sta SCREEN_RAM+$000,x\n    sta SCREEN_RAM+$100,x\n    sta SCREEN_RAM+$200,x\n    lda _map_colors+$000,x\n    sta COLOR_RAM+$000,x\n    lda _map_colors+$100,x\n    sta COLOR_RAM+$100,x\n    lda _map_colors+$200,x\n    sta COLOR_RAM+$200,x\n    inx\n    bne copy_map_pages\n    ldx #$6f\ncopy_map_tail:\n    lda #$01\n    sta SCREEN_RAM+$300,x\n    lda _map_colors+$300,x\n    sta COLOR_RAM+$300,x\n    dex\n    bpl copy_map_tail\n\n    ldx #$77\nclear_unused_rows:\n    lda #$01\n    sta SCREEN_RAM+$370,x\n    lda #$08\n    sta COLOR_RAM+$370,x\n    dex\n    bpl clear_unused_rows\n\n    lda #$01\n    sta VIC_SPRITE_ENABLE\n    sta VIC_SPRITE_MULTICOLOR\n    lda #$00\n    sta VIC_SPRITE_PRIORITY\n    sta VIC_SPRITE_X_EXPAND\n    sta VIC_SPRITE_Y_EXPAND\n    lda #$01\n    sta VIC_SPRITE_MC_0\n    lda #$00\n    sta VIC_SPRITE_MC_1\n    lda #$02\n    sta VIC_SPRITE_COLOR\n    lda #SPRITE_POINTER\n    sta SPRITE_POINTER_0\n    pla\n    tay\n    pla\n    tax\n    rts\n\nasm_wait_and_render:\n    txa\n    pha\n    tya\n    pha\nwait_not_f8:\n    lda RASTER\n    cmp #$f8\n    beq wait_not_f8\nwait_f8:\n    lda RASTER\n    cmp #$f8\n    bne wait_f8\n\n    lda _player_screen_x\n    sta VIC_SPRITE_X\n    lda VIC_SPRITE_X_MSB\n    and #$fe\n    ldx _player_screen_x+1\n    beq player_x_ready\n    ora #$01\nplayer_x_ready:\n    sta VIC_SPRITE_X_MSB\n    lda _player_screen_y\n    sta VIC_SPRITE_Y\n    lda _player_frame\n    clc\n    adc #SPRITE_POINTER\n    sta SPRITE_POINTER_0\n    pla\n    tay\n    pla\n    tax\n    rts\n\n; C passes the cell index through globals because the native compiler keeps\n; external binary assets read-only. These helpers deliberately mutate the\n; project-owned runtime copies of the map and material plane.\nselect_map_cell:\n    lda #$00\n    sta _map_cell_index\n    sta _map_cell_index+1\n    ldx _map_cell_row\nselect_map_row:\n    cpx #$00\n    beq select_map_column\n    clc\n    lda _map_cell_index\n    adc #$28\n    sta _map_cell_index\n    lda _map_cell_index+1\n    adc #$00\n    sta _map_cell_index+1\n    dex\n    jmp select_map_row\nselect_map_column:\n    clc\n    lda _map_cell_index\n    adc _map_cell_column\n    sta _map_cell_index\n    lda _map_cell_index+1\n    adc #$00\n    sta _map_cell_index+1\n    rts\n\nasm_read_material:\n    txa\n    pha\n    tya\n    pha\n    jsr select_map_cell\n    clc\n    lda #<_map_material\n    adc _map_cell_index\n    sta read_material_byte+1\n    lda #>_map_material\n    adc _map_cell_index+1\n    sta read_material_byte+2\nread_material_byte:\n    lda $ffff\n    sta _map_cell_value\n    pla\n    tay\n    pla\n    tax\n    rts\n\nasm_erase_cell:\n    txa\n    pha\n    tya\n    pha\n    jsr select_map_cell\n    clc\n    lda #<_map_material\n    adc _map_cell_index\n    sta erase_material_byte+1\n    lda #>_map_material\n    adc _map_cell_index+1\n    sta erase_material_byte+2\n    lda #$00\nerase_material_byte:\n    sta $ffff\n\n    clc\n    lda #<_map_chars\n    adc _map_cell_index\n    sta erase_map_byte+1\n    lda #>_map_chars\n    adc _map_cell_index+1\n    sta erase_map_byte+2\n    lda _map_cell_character\nerase_map_byte:\n    sta $ffff\n\n    clc\n    lda #<_map_colors\n    adc _map_cell_index\n    sta erase_map_color_byte+1\n    lda #>_map_colors\n    adc _map_cell_index+1\n    sta erase_map_color_byte+2\n    lda #$09\nerase_map_color_byte:\n    sta $ffff\n\n    clc\n    lda #<SCREEN_RAM\n    adc _map_cell_index\n    sta erase_screen_byte+1\n    lda #>SCREEN_RAM\n    adc _map_cell_index+1\n    sta erase_screen_byte+2\n    lda #$01\nerase_screen_byte:\n    sta $ffff\n\n    clc\n    lda #<COLOR_RAM\n    adc _map_cell_index\n    sta erase_color_ram_byte+1\n    lda #>COLOR_RAM\n    adc _map_cell_index+1\n    sta erase_color_ram_byte+2\n    lda #$09\nerase_color_ram_byte:\n    sta $ffff\n    jsr draw_selected_bitmap_cell\n    pla\n    tay\n    pla\n    tax\n    rts\n\n\n; Clear the 8 KiB bitmap and expand all 40x22 authored character cells into it.\n; The VIC stores each 8x8 bitmap cell as eight consecutive bytes. Bitmap color\n; 0 is D021, colors 1/2 are the two screen nibbles, and color 3 is the full\n; four-bit Color RAM value, matching the map editor's palette.\nbuild_bitmap_map:\n    lda #<BITMAP_DEST\n    sta clear_bitmap_byte+1\n    lda #>BITMAP_DEST\n    sta clear_bitmap_byte+2\n    ldx #$00\n    ldy #$20\n    lda #$00\nclear_bitmap_page:\nclear_bitmap_byte:\n    sta $ffff,x\n    inx\n    bne clear_bitmap_page\n    inc clear_bitmap_byte+2\n    dey\n    bne clear_bitmap_page\n\n    lda #<_map_chars\n    sta build_map_character+1\n    lda #>_map_chars\n    sta build_map_character+2\n    lda #<BITMAP_DEST\n    sta build_bitmap_byte+1\n    lda #>BITMAP_DEST\n    sta build_bitmap_byte+2\n    lda #$70\n    sta bitmap_cells_low\n    lda #$03\n    sta bitmap_cells_high\nbuild_bitmap_cell:\nbuild_map_character:\n    lda $ffff\n    sta bitmap_char_low\n    lda #$00\n    sta bitmap_char_high\n    ldx #$03\nbuild_character_offset:\n    asl bitmap_char_low\n    rol bitmap_char_high\n    dex\n    bne build_character_offset\n    clc\n    lda bitmap_char_low\n    adc #<_charset_data\n    sta build_character_byte+1\n    lda bitmap_char_high\n    adc #>_charset_data\n    sta build_character_byte+2\n    ldy #$00\nbuild_character_rows:\nbuild_character_byte:\n    lda $ffff,y\nbuild_bitmap_byte:\n    sta $ffff,y\n    iny\n    cpy #$08\n    bne build_character_rows\n    inc build_map_character+1\n    bne build_map_pointer_ready\n    inc build_map_character+2\nbuild_map_pointer_ready:\n    clc\n    lda build_bitmap_byte+1\n    adc #$08\n    sta build_bitmap_byte+1\n    bcc build_bitmap_pointer_ready\n    inc build_bitmap_byte+2\nbuild_bitmap_pointer_ready:\n    lda bitmap_cells_low\n    bne build_decrement_low\n    dec bitmap_cells_high\nbuild_decrement_low:\n    dec bitmap_cells_low\n    lda bitmap_cells_low\n    ora bitmap_cells_high\n    bne build_bitmap_cell\n    rts\n\n; Redraw the selected map cell after an egg character is replaced.\ndraw_selected_bitmap_cell:\n    lda _map_cell_index\n    sta bitmap_cell_low\n    lda _map_cell_index+1\n    sta bitmap_cell_high\n    ldx #$03\ndraw_cell_offset:\n    asl bitmap_cell_low\n    rol bitmap_cell_high\n    dex\n    bne draw_cell_offset\n    clc\n    lda bitmap_cell_low\n    adc #<BITMAP_DEST\n    sta draw_bitmap_byte+1\n    lda bitmap_cell_high\n    adc #>BITMAP_DEST\n    sta draw_bitmap_byte+2\n\n    lda _map_cell_character\n    sta bitmap_char_low\n    lda #$00\n    sta bitmap_char_high\n    ldx #$03\ndraw_character_offset:\n    asl bitmap_char_low\n    rol bitmap_char_high\n    dex\n    bne draw_character_offset\n    clc\n    lda bitmap_char_low\n    adc #<_charset_data\n    sta draw_character_byte+1\n    lda bitmap_char_high\n    adc #>_charset_data\n    sta draw_character_byte+2\n    ldy #$00\ndraw_character_rows:\ndraw_character_byte:\n    lda $ffff,y\ndraw_bitmap_byte:\n    sta $ffff,y\n    iny\n    cpy #$08\n    bne draw_character_rows\n    rts\n\nbitmap_cells_low:\n    .byte $00\nbitmap_cells_high:\n    .byte $00\nbitmap_char_low:\n    .byte $00\nbitmap_char_high:\n    .byte $00\nbitmap_cell_low:\n    .byte $00\nbitmap_cell_high:\n    .byte $00\n\nasm_count_eggs:\n    txa\n    pha\n    tya\n    pha\n    lda #$00\n    sta _eggs_remaining\n    ldx #$00\ncount_egg_pages:\n    lda _map_material+$000,x\n    cmp #$03\n    bne count_egg_page_1\n    inc _eggs_remaining\ncount_egg_page_1:\n    lda _map_material+$100,x\n    cmp #$03\n    bne count_egg_page_2\n    inc _eggs_remaining\ncount_egg_page_2:\n    lda _map_material+$200,x\n    cmp #$03\n    bne count_egg_page_next\n    inc _eggs_remaining\ncount_egg_page_next:\n    inx\n    bne count_egg_pages\n    ldx #$00\ncount_egg_tail:\n    lda _map_material+$300,x\n    cmp #$03\n    bne count_egg_tail_next\n    inc _eggs_remaining\ncount_egg_tail_next:\n    inx\n    cpx #$70\n    bne count_egg_tail\n    lsr _eggs_remaining\n    lsr _eggs_remaining\n    pla\n    tay\n    pla\n    tax\n    rts\n\n.incbin _charset_data, \"assets/chars/charset.chr\"\n.incbin _sprite_data, \"assets/sprites/sprites.spr\"\n.incbin _map_chars, \"assets/maps/map.map\"\n.incbin _map_colors, \"assets/maps/map.color.bin\"\n.incbin _map_material, \"assets/maps/map.material.bin\"\n"
    },
    {
      "path": "src/render.h",
      "name": "render.h",
      "kind": "source",
      "source": "#ifndef EGG_HUNT_RENDER_H\n#define EGG_HUNT_RENDER_H\n\nvoid asm_setup_game(void);\nvoid asm_wait_and_render(void);\nvoid asm_read_material(void);\nvoid asm_erase_cell(void);\nvoid asm_count_eggs(void);\n\n#endif\n"
    },
    {
      "path": "TEMPLATE.md",
      "name": "TEMPLATE.md",
      "kind": "source",
      "source": "# Egg Hunt\n\nA single-screen multicolor character-mode platform game. Use joystick port 2\n(numeric keypad in the emulator) to steer the chicken. Horizontal movement\naccelerates and brakes gradually; up/down enters a ladder when the chicken is\naligned with it.\n\n## Gameplay\n\n- Platforms use material 1, ladders material 2, and eggs material 3.\n- Eggs are 2x2 character objects and are removed from the character, color,\n  and material planes when collected.\n- Walk, fly/fall, left/right, climb, and brief turn animations use all ten\n  frames in the chicken sprite bank.\n- Collecting the final egg changes the border to yellow.\n\n## Project contract\n\n- Entry: main.c\n- Language: mixed C and 6502 assembly\n- Origin: $6000\n- Video: PAL; authored as a 40x22 multicolor character map and expanded to\n  a multicolor bitmap at startup so all four authored Color RAM bits display\n- Native assets: charset, 40x22 map with color/material planes, sprite bank\n- Controls: joystick port 2\n"
    }
  ]
}
