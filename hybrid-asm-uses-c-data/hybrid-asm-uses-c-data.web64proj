      "kind": "source",
      "source": "/*\n * Web64 IDE Example\n * Name: Hybrid ASM Uses C Data\n * Description: Calls assembly that reads a global emitted by Web64 C.\n */\n\n#include <stdint.h>\n\nuint8_t border_from_c = 4;\n\nvoid asm_apply_border_from_c(void);\n\nvoid main(void) {\n    border_from_c = 4;\n    asm_apply_border_from_c();\n    while (1) {\n    }\n}\n"
    }
  ]
