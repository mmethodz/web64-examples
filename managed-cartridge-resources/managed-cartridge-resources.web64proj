  "savedAt": "2026-09-27T21:30:20.417Z",
  "main": {
    "fileName": "main.c",
    "origin": "$2000",
    "source": "#include <web64/cartridge.h>\n#include <cartridge/generated.h>\n\nweb64_cart_resource_request request;\nweb64_cart_resource_result result;\nuint8_t asm_palette_probe(void);\nvolatile uint8_t *screen;\nvolatile uint8_t *colors;\nuint16_t cell;\n\nvoid main(void) {\n    screen = (volatile uint8_t *)0x0400;\n    colors = (volatile uint8_t *)0xd800;\n    /* Cartridge autostart precedes KERNAL screen initialization. */\n    ((volatile uint8_t *)0x0001)[0] = 0x37;\n    ((volatile uint8_t *)0xd01a)[0] = 0;\n    ((volatile uint8_t *)0xd015)[0] = 0;\n    ((volatile uint8_t *)0xdd02)[0] |= 3;\n    ((volatile uint8_t *)0xdd00)[0] |= 3;\n    ((volatile uint8_t *)0xd011)[0] = 0x1b;\n    ((volatile uint8_t *)0xd016)[0] = 0x08;\n    ((volatile uint8_t *)0xd018)[0] = 0x14;\n    ((volatile uint8_t *)0xd020)[0] = 0;\n    ((volatile uint8_t *)0xd021)[0] = 0;\n    for (cell = 0; cell < 1000; ++cell) {\n        screen[cell] = 32;\n        colors[cell] = 1;\n    }\n    uint8_t status = web64_cart_resources_init();\n    request.resource = WEB64_CART_RESOURCE_PALETTE;\n    request.offset = 0UL;\n    request.destination = (uint8_t *)0x5000;\n    request.length = 4;\n    if (status == WEB64_CART_OK) status = web64_cart_resource_read(&request, &result);\n    if (status == WEB64_CART_OK && result.completed == 4) {\n        /* The border and background colors came from the logical ROM resource. */\n        screen[0] = 23; screen[1] = 5; screen[2] = 2; screen[3] = 54; screen[4] = 52;\n        ((volatile uint8_t *)0xd020)[0] = ((volatile uint8_t *)0x5000)[0];\n        ((volatile uint8_t *)0xd021)[0] = ((volatile uint8_t *)0x5000)[1];\n        /* The assembly include reads the same logical ID into a second buffer. */\n        if (asm_palette_probe() == WEB64_CART_OK &&\n            ((volatile uint8_t *)0x5004)[0] == ((volatile uint8_t *)0x5000)[0]) {\n            screen[6] = 1; screen[7] = 19; screen[8] = 13;\n        }\n    } else {\n        screen[0] = 5; screen[1] = 18; screen[2] = 18;\n        ((volatile uint8_t *)0xd020)[0] = 2;\n    }\n    for (;;) { }\n}\n",
    "selectedEntryLabel": "auto"
  },
