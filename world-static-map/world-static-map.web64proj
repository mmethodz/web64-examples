  "main": {
    "fileName": "main.c",
    "origin": "$5000",
    "source": "#include <stdint.h>\n#include <c64.h>\n#include <6502.h>\n#include <assets/generated.h>\n#include <web64/world.h>\n#include <web64/sprite-runtime.h>\n\n#define WORLD_SCREEN ((uint8_t*)0x0400)\n#define WORLD_COLOR_RAM ((uint8_t*)0xd800)\n#define WORLD_CHARSET ((uint8_t*)0x2000)\n#define PLAYER_SPRITES ((uint8_t*)0x3000)\n#define SPRITE_POINTERS ((uint8_t*)0x07f8)\n#define PLAYER_SPRITE_POINTER 0xc0\n#define VIEW_ROWS 22\n#define WORLD_COLOR_MODE WEB64_WORLD_COLOR_PER_CELL\n#define WORLD_VIDEO_FLAGS 0\n\nWeb64WorldCamera camera;\nWeb64SpriteRenderer sprite_renderer;\nuint16_t player_x;\nuint8_t player_y;\n\nstatic void wait_frame(void) {\n  uint8_t raster;\n  raster = *((uint8_t*)0xd012);\n  while (raster != 250) {\n    raster = *((uint8_t*)0xd012);\n  }\n  while (raster == 250) {\n    raster = *((uint8_t*)0xd012);\n  }\n}\n\nstatic void install_assets(void) {\n  *((uint8_t*)0xdd00) = (*((uint8_t*)0xdd00) & 0xfc) | 3;\n  web64_world_copy_asset(WORLD_CHARSET, world_chars, world_chars_size);\n  web64_world_copy_asset(PLAYER_SPRITES, player_sprites, player_sprites_size);\n  SPRITE_POINTERS[0] = PLAYER_SPRITE_POINTER;\n}\n\nstatic void render_player(void) {\n  web64_sprite_render(&sprite_renderer, 0, player_x, player_y, PLAYER_SPRITE_POINTER, COLOR_WHITE, WEB64_SPRITE_VISIBLE);\n}\n\nstatic void update_player(void) {\n  uint8_t joy;\n  joy = *((uint8_t*)JOYPORT_2);\n  if ((joy & 4) == 0 && player_x > 24) player_x = player_x - 1;\n  if ((joy & 8) == 0 && player_x < 319) player_x = player_x + 1;\n  if ((joy & 1) == 0 && player_y > 52) player_y = player_y - 1;\n  if ((joy & 2) == 0 && player_y < 224) player_y = player_y + 1;\n  if ((joy & 16) == 0) {\n    web64_world_mutate_cell(world_map, world_color, world_material, WORLD_SCREEN, WORLD_COLOR_RAM, &camera, 20, 10, 26, COLOR_YELLOW, 1, 40, 40, WORLD_COLOR_MODE);\n  }\n}\n\nstatic void initialize_world(void) {\n  SEI();\n  *((uint8_t*)0xdc0d) = 0x7f;\n  *((uint8_t*)0xdd0d) = 0x7f;\n  *((uint8_t*)0xd020) = COLOR_BLACK;\n  *((uint8_t*)0xd021) = COLOR_BLACK;\n  camera.x = 0;\n  camera.y = 0;\n  camera.fine_x = 0;\n  camera.fine_y = 0;\n  player_x = 160;\n  player_y = 120;\n  install_assets();\n  web64_world_apply_video_mode(WORLD_VIDEO_FLAGS, 0x18);\n  web64_world_draw_char_view(world_map, world_color, WORLD_SCREEN, WORLD_COLOR_RAM, 40, VIEW_ROWS, 40, WORLD_COLOR_MODE, 14);\n  web64_sprite_renderer_init(&sprite_renderer, (uint16_t)SPRITE_POINTERS);\n  render_player();\n}\n\nvoid main(void) {\n  initialize_world();\n  while (1) {\n    wait_frame();\n    update_player();\n    render_player();\n  }\n}\n",
    "selectedEntryLabel": "auto"
  },
