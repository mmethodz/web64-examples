    {
      "path": "main.c",
      "name": "main.c",
      "kind": "source",
      "dirty": true,
      "source": "/*\n * C Fixed Motion\n *\n * Joystick 2 changes acceleration. Release it to coast to a stop;\n * hold FIRE to brake immediately. The UFO position comes only from\n * the integrated 8.8 Web64Motion2D state.\n */\n#include <stdint.h>\n#include <string.h>\n#include <web64.h>\n#include <web64/fixed.h>\n#include \"assets/generated.h\"\n\n#define SCREEN 0x0400\n#define COLOR 0xd800\n#define SPRITE_DATA 0x3000\n#define THRUST 0x0020\n#define DRAG 0x0010\n#define TOP_SPEED 0x0280\n#define X_MIN WEB64_FIX8_FROM_INT(-110)\n#define X_MAX WEB64_FIX8_FROM_INT(100)\n#define Y_MIN WEB64_FIX8_FROM_INT(-70)\n#define Y_MAX WEB64_FIX8_FROM_INT(65)\n\n#pragma charset(\"screencode_mixed\")\nconst char title[] = \"fixed motion 8.8\";\nconst char guide[] = \"joy 2: thrust    release: coast\";\nconst char brake[] = \"fire: brake\";\nconst char pos_label[] = \"position x:$\";\nconst char pos_y_label[] = \" y:$\";\nconst char vel_label[] = \"velocity x:$\";\nconst char vel_y_label[] = \" y:$\";\nconst char thrust_text[] = \"thrust\";\nconst char coast_text[] = \"coast \";\nconst char brake_text[] = \"brake \";\n#pragma charset(\"ascii\")\n\nWeb64Motion2D motion;\nuint8_t joy;\nuint8_t cell;\nuint16_t screen_offset;\n\nvoid put_text(uint16_t offset, const char *text) {\n    uint8_t index = 0;\n    while (text[index] != 0) {\n        *(uint8_t*)(SCREEN + offset + index) = text[index];\n        index++;\n    }\n}\n\nvoid put_hex_digit(uint8_t digit, uint16_t offset) {\n    if (digit < 10) {\n        *(uint8_t*)(SCREEN + offset) = 48 + digit;\n    } else {\n        *(uint8_t*)(SCREEN + offset) = 1 + digit - 10;\n    }\n}\n\nvoid put_hex16(uint16_t value, uint16_t offset) {\n    put_hex_digit((uint8_t)((value >> 12) & 15), offset);\n    put_hex_digit((uint8_t)((value >> 8) & 15), offset + 1);\n    put_hex_digit((uint8_t)((value >> 4) & 15), offset + 2);\n    put_hex_digit((uint8_t)(value & 15), offset + 3);\n}\n\nvoid clear_screen(void) {\n    for (screen_offset = 0; screen_offset < 1000; screen_offset++) {\n        *(uint8_t*)(SCREEN + screen_offset) = 32;\n        *(uint8_t*)(COLOR + screen_offset) = 1;\n    }\n}\n\nvoid wait_frame(void) {\n    while (*(uint8_t*)0xd012 == 250) {}\n    while (*(uint8_t*)0xd012 != 250) {}\n}\n\nvoid slow_x(void) {\n    if (motion.velocity.x > DRAG) motion.velocity.x -= DRAG;\n    else if (motion.velocity.x < -DRAG) motion.velocity.x += DRAG;\n    else motion.velocity.x = 0;\n}\n\nvoid slow_y(void) {\n    if (motion.velocity.y > DRAG) motion.velocity.y -= DRAG;\n    else if (motion.velocity.y < -DRAG) motion.velocity.y += DRAG;\n    else motion.velocity.y = 0;\n}\n\nvoid read_controls(void) {\n    joy = *(uint8_t*)0xdc00;\n    motion.acceleration.x = 0;\n    motion.acceleration.y = 0;\n    if (!(joy & 16)) {\n        motion.velocity.x = 0;\n        motion.velocity.y = 0;\n        put_text(40 * 23 + 1, brake_text);\n        *(uint8_t*)0xd020 = 2;\n        return;\n    }\n    if (!(joy & 4) && (joy & 8)) motion.acceleration.x = -THRUST;\n    if (!(joy & 8) && (joy & 4)) motion.acceleration.x = THRUST;\n    if (!(joy & 1) && (joy & 2)) motion.acceleration.y = -THRUST;\n    if (!(joy & 2) && (joy & 1)) motion.acceleration.y = THRUST;\n    if (motion.acceleration.x == 0) slow_x();\n    if (motion.acceleration.y == 0) slow_y();\n    if (motion.acceleration.x || motion.acceleration.y) {\n        put_text(40 * 23 + 1, thrust_text);\n        *(uint8_t*)0xd020 = 6;\n    } else {\n        put_text(40 * 23 + 1, coast_text);\n        *(uint8_t*)0xd020 = 11;\n    }\n}\n\nvoid bound_motion(void) {\n    if (motion.velocity.x > TOP_SPEED) motion.velocity.x = TOP_SPEED;\n    if (motion.velocity.x < -TOP_SPEED) motion.velocity.x = -TOP_SPEED;\n    if (motion.velocity.y > TOP_SPEED) motion.velocity.y = TOP_SPEED;\n    if (motion.velocity.y < -TOP_SPEED) motion.velocity.y = -TOP_SPEED;\n\n    if (motion.position.x < X_MIN) {\n        motion.position.x = X_MIN;\n        motion.velocity.x = 0;\n    }\n    if (motion.position.x > X_MAX) {\n        motion.position.x = X_MAX;\n        motion.velocity.x = 0;\n    }\n    if (motion.position.y < Y_MIN) {\n        motion.position.y = Y_MIN;\n        motion.velocity.y = 0;\n    }\n    if (motion.position.y > Y_MAX) {\n        motion.position.y = Y_MAX;\n        motion.velocity.y = 0;\n    }\n}\n\nvoid render_motion(void) {\n    *(uint8_t*)0xd000 = 144 + WEB64_FIX8_TO_INT(motion.position.x);\n    *(uint8_t*)0xd001 = 130 + WEB64_FIX8_TO_INT(motion.position.y);\n    put_hex16((uint16_t)motion.position.x, 40 * 20 + 13);\n    put_hex16((uint16_t)motion.position.y, 40 * 20 + 22);\n    put_hex16((uint16_t)motion.velocity.x, 40 * 21 + 13);\n    put_hex16((uint16_t)motion.velocity.y, 40 * 21 + 22);\n}\n\nvoid main(void) {\n    *(uint8_t*)0xdc02 = 0;\n    *(uint8_t*)0xdc03 = 0;\n    *(uint8_t*)0xd020 = 11;\n    *(uint8_t*)0xd021 = 0;\n    CURSOFF();\n    motion.position.x = 0;\n    motion.position.y = 0;\n    motion.velocity.x = 0;\n    motion.velocity.y = 0;\n    motion.acceleration.x = 0;\n    motion.acceleration.y = 0;\n    clear_screen();\n    put_text(40 + 11, title);\n    put_text(80 + 4, guide);\n    put_text(120 + 4, brake);\n    put_text(40 * 20 + 1, pos_label);\n    put_text(40 * 20 + 18, pos_y_label);\n    put_text(40 * 21 + 1, vel_label);\n    put_text(40 * 21 + 18, vel_y_label);\n    memcpy((void*)SPRITE_DATA, ufo_sprites, ufo_sprites_size);\n    *(uint8_t*)0x07f8 = SPRITE_DATA / 64;\n    *(uint8_t*)0xd010 = 0;\n    *(uint8_t*)0xd01c = 0;\n    *(uint8_t*)0xd017 = 0;\n    *(uint8_t*)0xd01d = 0;\n    *(uint8_t*)0xd027 = 1;\n    *(uint8_t*)0xd015 = 1;\n    render_motion();\n    while (1) {\n        wait_frame();\n        read_controls();\n        web64_motion2d_integrate(&motion);\n        bound_motion();\n        render_motion();\n    }\n}\n"
    },
