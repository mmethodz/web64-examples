      "kind": "source",
      "source": "; Web64 IDE Example\n; Name: Platform Jumper Assets\n; Description: Explicit asset linking and deterministic VIC memory copies.\n\n_copy_assets:\n    ldx #$00\ncopy_charset:\n    lda charset_chars+$000,x\n    sta $2800,x\n    lda charset_chars+$100,x\n    sta $2900,x\n    lda charset_chars+$200,x\n    sta $2a00,x\n    lda charset_chars+$300,x\n    sta $2b00,x\n    lda charset_chars+$400,x\n    sta $2c00,x\n    lda charset_chars+$500,x\n    sta $2d00,x\n    lda charset_chars+$600,x\n    sta $2e00,x\n    lda charset_chars+$700,x\n    sta $2f00,x\n    inx\n    bne copy_charset\n\n    ldx #$00\ncopy_sprite:\n    lda sprites_sprites,x\n    sta $3000,x\n    inx\n    cpx #$40\n    bne copy_sprite\n    rts\n\n; Expand the 20x12 block map into 40x24 screen characters.\n; $f0-$fa are outside Web64-C's reserved zero-page ranges.\n_render_map:\n    lda #<map_map\n    sta $f0\n    lda #>map_map\n    sta $f1\n    lda #<$0400\n    sta $f2\n    lda #>$0400\n    sta $f3\n    lda #<$0428\n    sta $f4\n    lda #>$0428\n    sta $f5\n    ldx #$0c\n\nrender_block_row:\n    ldy #$00\n\nrender_block_column:\n    tya\n    pha\n\n    lda #$00\n    sta $fa\n    lda ($f0),y\n    asl\n    rol $fa\n    asl\n    rol $fa\n    clc\n    adc #<blocks_blocks\n    sta $f6\n    lda $fa\n    adc #>blocks_blocks\n    sta $f7\n\n    pla\n    pha\n    asl\n    sta $f8\n\n    ldy #$00\n    lda ($f6),y\n    ldy $f8\n    sta ($f2),y\n\n    ldy #$01\n    lda ($f6),y\n    ldy $f8\n    iny\n    sta ($f2),y\n\n    ldy #$02\n    lda ($f6),y\n    ldy $f8\n    sta ($f4),y\n\n    ldy #$03\n    lda ($f6),y\n    ldy $f8\n    iny\n    sta ($f4),y\n\n    pla\n    tay\n    iny\n    cpy #$14\n    bne render_block_column\n\n    clc\n    lda $f0\n    adc #$14\n    sta $f0\n    bcc render_map_source_ready\n    inc $f1\n\nrender_map_source_ready:\n    clc\n    lda $f2\n    adc #$50\n    sta $f2\n    bcc render_map_top_ready\n    inc $f3\n\nrender_map_top_ready:\n    clc\n    lda $f4\n    adc #$50\n    sta $f4\n    bcc render_map_bottom_ready\n    inc $f5\n\nrender_map_bottom_ready:\n    dex\n    bne render_block_row\n    rts\n\n; Explicit assembly ownership keeps project assets visible and predictable.\n.incbin blocks_blocks, \"blocks.blk\"\n.include \"blocks.inc\"\n.incbin charset_chars, \"charset.chr\"\n.include \"charset.inc\"\n.incbin map_map, \"map.map\"\n.include \"map.inc\"\n.incbin sprites_sprites, \"sprites.spr\"\n.include \"sprites.inc\"\n"
    },
