    {
      "path": "main.c",
      "name": "main.c",
      "kind": "source",
      "source": "/*\n * Web64 IDE Example\n * Name: Platform Jumper\n * Description: Single-screen platform jumping over a map-backed multicolor level.\n *\n * Joystick port 2:\n *   Left / Right - move\n *   Fire         - jump\n *\n * Collision types:\n *   0   empty\n *   1-3 one-way platforms\n *   4   fully solid\n *   5   visual shading only\n */\n\n#include <stdint.h>\n#include <c64.h>\n#include \"assets/generated.h\"\n\nvoid copy_assets(void);\nvoid render_map(void);\n\n#define SCREEN_RAM 0x0400\n#define COLOR_RAM 0xd800\n#define CHARSET_RAM 0x2800\n#define SPRITE_RAM 0x3000\n\n#define VIC_CONTROL1 0xd011\n#define VIC_CONTROL2 0xd016\n#define VIC_MEMORY 0xd018\n#define VIC_RASTER 0xd012\n#define VIC_SPRITE0_X 0xd000\n#define VIC_SPRITE0_Y 0xd001\n#define VIC_SPRITE_X_MSB 0xd010\n#define VIC_SPRITE_ENABLE 0xd015\n#define VIC_SPRITE_MULTICOLOR 0xd01c\n#define VIC_BORDER 0xd020\n#define VIC_BACKGROUND 0xd021\n#define VIC_MULTICOLOR_1 0xd022\n#define VIC_MULTICOLOR_2 0xd023\n#define VIC_SPRITE_MC_1 0xd025\n#define VIC_SPRITE_MC_2 0xd026\n#define VIC_SPRITE0_COLOR 0xd027\n#define VIC_SPRITE_POINTER 0x07f8\n\n#define CIA1_PORT_A 0xdc00\n#define CIA1_DDRA 0xdc02\n\n#define MAP_BLOCK_COLUMNS 20\n#define MAP_BLOCK_ROWS 12\n#define MAP_CHAR_COLUMNS 40\n#define MAP_CHAR_ROWS 24\n#define MAP_PIXEL_WIDTH 320\n#define MAP_PIXEL_HEIGHT 192\n\n#define POSITION_SCALE 16\n#define PLAYER_WIDTH 21\n#define PLAYER_HEIGHT 21\n#define PLAYER_LEFT_INSET 3\n#define PLAYER_RIGHT_INSET 20\n#define PLAYER_TOP_INSET 1\n#define PLAYER_BOTTOM_INSET 20\n#define PLAYER_START_X 768\n#define PLAYER_START_Y 2480\n#define PLAYER_MAX_X 4736\n\n#define MOVE_ACCEL 2\n#define MOVE_DECEL 2\n#define MOVE_MAX 24\n#define GRAVITY 4\n#define JUMP_SPEED 80\n#define JUMP_RELEASE_SPEED 32\n#define FALL_MAX 64\n\nint16_t player_x = PLAYER_START_X;\nint16_t player_y = PLAYER_START_Y;\nint16_t player_dx = 0;\nint16_t player_dy = 0;\n\nuint8_t joystick = JOY_RELEASED_MASK;\nuint8_t jump_held = 0;\nuint8_t grounded = 1;\n\nuint8_t map_block_at(uint16_t pixel_x, int16_t pixel_y) {\n    uint8_t block_x;\n    uint8_t block_y;\n\n    if (pixel_x >= MAP_PIXEL_WIDTH) {\n        return 0;\n    }\n    if (pixel_y < 0) {\n        return 0;\n    }\n    if (pixel_y >= MAP_PIXEL_HEIGHT) {\n        return 0;\n    }\n\n    block_x = (uint8_t)(pixel_x / 16);\n    block_y = (uint8_t)(pixel_y / 16);\n    return *((const uint8_t*)map_map + ((uint16_t)block_y * MAP_BLOCK_COLUMNS) + block_x);\n}\n\nuint8_t is_platform(uint8_t block) {\n    if (block < 1) {\n        return 0;\n    }\n    if (block > 3) {\n        return 0;\n    }\n    return 1;\n}\n\nuint8_t is_solid(uint8_t block) {\n    if (block == 4) {\n        return 1;\n    }\n    return 0;\n}\n\nvoid clear_screen(void) {\n    uint16_t offset;\n\n    for (offset = 0; offset < 1000; offset++) {\n        *((uint8_t*)(SCREEN_RAM + offset)) = 0;\n        *((uint8_t*)(COLOR_RAM + offset)) = 9;\n    }\n}\n\nvoid setup_video(void) {\n    *((uint8_t*)CIA1_DDRA) = 0;\n    *((uint8_t*)VIC_BORDER) = 6;\n    *((uint8_t*)VIC_BACKGROUND) = 0;\n    *((uint8_t*)VIC_MULTICOLOR_1) = 5;\n    *((uint8_t*)VIC_MULTICOLOR_2) = 9;\n    *((uint8_t*)VIC_CONTROL1) = 0x1b;\n    *((uint8_t*)VIC_CONTROL2) = 0x18;\n    *((uint8_t*)VIC_MEMORY) = 0x1a;\n\n    copy_assets();\n\n    *((uint8_t*)VIC_SPRITE_POINTER) = 0xc0;\n    *((uint8_t*)VIC_SPRITE_MULTICOLOR) = 1;\n    *((uint8_t*)VIC_SPRITE_MC_1) = 1;\n    *((uint8_t*)VIC_SPRITE_MC_2) = 9;\n    *((uint8_t*)VIC_SPRITE0_COLOR) = 4;\n    *((uint8_t*)VIC_SPRITE_ENABLE) = 1;\n\n    clear_screen();\n    render_map();\n}\n\nvoid wait_frame(void) {\n    while (*((volatile uint8_t*)VIC_RASTER) == 0xf8) {\n    }\n    while (*((volatile uint8_t*)VIC_RASTER) != 0xf8) {\n    }\n}\n\nvoid read_joystick(void) {\n    joystick = *((uint8_t*)CIA1_PORT_A);\n}\n\nvoid update_horizontal_input(void) {\n    if ((joystick & JOY_LEFT) == 0) {\n        player_dx = player_dx - MOVE_ACCEL;\n        if (player_dx < -MOVE_MAX) {\n            player_dx = -MOVE_MAX;\n        }\n        return;\n    }\n\n    if ((joystick & JOY_RIGHT) == 0) {\n        player_dx = player_dx + MOVE_ACCEL;\n        if (player_dx > MOVE_MAX) {\n            player_dx = MOVE_MAX;\n        }\n        return;\n    }\n\n    if (player_dx > 0) {\n        player_dx = player_dx - MOVE_DECEL;\n        if (player_dx < 0) {\n            player_dx = 0;\n        }\n        return;\n    }\n\n    if (player_dx < 0) {\n        player_dx = player_dx + MOVE_DECEL;\n        if (player_dx > 0) {\n            player_dx = 0;\n        }\n    }\n}\n\nvoid update_jump(void) {\n    if ((joystick & JOY_FIRE) == 0) {\n        if ((jump_held == 0) && (grounded != 0)) {\n            player_dy = -JUMP_SPEED;\n            grounded = 0;\n        }\n        jump_held = 1;\n        return;\n    }\n\n    jump_held = 0;\n    if (player_dy < -JUMP_RELEASE_SPEED) {\n        player_dy = -JUMP_RELEASE_SPEED;\n    }\n}\n\nvoid apply_gravity(void) {\n    player_dy = player_dy + GRAVITY;\n    if (player_dy > FALL_MAX) {\n        player_dy = FALL_MAX;\n    }\n}\n\nuint8_t edge_hits_solid(uint16_t probe_x, int16_t pixel_y) {\n    if (is_solid(map_block_at(probe_x, pixel_y + PLAYER_TOP_INSET)) != 0) {\n        return 1;\n    }\n    if (is_solid(map_block_at(probe_x, pixel_y + 10)) != 0) {\n        return 1;\n    }\n    if (is_solid(map_block_at(probe_x, pixel_y + PLAYER_BOTTOM_INSET)) != 0) {\n        return 1;\n    }\n    return 0;\n}\n\nuint8_t resolve_right_solid(int16_t pixel_x, int16_t pixel_y) {\n    uint16_t probe_x;\n    int16_t block_edge;\n\n    probe_x = (uint16_t)(pixel_x + PLAYER_RIGHT_INSET);\n    if (edge_hits_solid(probe_x, pixel_y) == 0) {\n        return 0;\n    }\n\n    block_edge = (int16_t)((probe_x / 16) * 16);\n    player_x = (block_edge - PLAYER_RIGHT_INSET - 1) * POSITION_SCALE;\n    player_dx = 0;\n    return 1;\n}\n\nuint8_t resolve_left_solid(int16_t pixel_x, int16_t pixel_y) {\n    uint16_t probe_x;\n    int16_t block_edge;\n\n    probe_x = (uint16_t)(pixel_x + PLAYER_LEFT_INSET);\n    if (edge_hits_solid(probe_x, pixel_y) == 0) {\n        return 0;\n    }\n\n    block_edge = (int16_t)(((probe_x / 16) + 1) * 16);\n    player_x = (block_edge - PLAYER_LEFT_INSET) * POSITION_SCALE;\n    player_dx = 0;\n    return 1;\n}\n\nvoid move_horizontal(void) {\n    int16_t candidate;\n    int16_t pixel_x;\n    int16_t pixel_y;\n\n    candidate = player_x + player_dx;\n    if (candidate < 0) {\n        player_x = 0;\n        player_dx = 0;\n        return;\n    }\n    if (candidate > PLAYER_MAX_X) {\n        player_x = PLAYER_MAX_X;\n        player_dx = 0;\n        return;\n    }\n\n    pixel_x = candidate / POSITION_SCALE;\n    pixel_y = player_y / POSITION_SCALE;\n    if (player_dx > 0) {\n        if (resolve_right_solid(pixel_x, pixel_y) != 0) {\n            return;\n        }\n    }\n\n    if (player_dx < 0) {\n        if (resolve_left_solid(pixel_x, pixel_y) != 0) {\n            return;\n        }\n    }\n\n    player_x = candidate;\n}\n\nvoid move_vertical(void) {\n    int16_t old_pixel_y;\n    int16_t new_pixel_y;\n    int16_t candidate;\n    int16_t player_pixel_x;\n    int16_t probe_y;\n    int16_t surface_y;\n    uint16_t left_x;\n    uint16_t right_x;\n    uint8_t left_block;\n    uint8_t right_block;\n\n    old_pixel_y = player_y / POSITION_SCALE;\n    candidate = player_y + player_dy;\n    new_pixel_y = candidate / POSITION_SCALE;\n    player_pixel_x = player_x / POSITION_SCALE;\n    left_x = (uint16_t)(player_pixel_x + PLAYER_LEFT_INSET);\n    right_x = (uint16_t)(player_pixel_x + PLAYER_RIGHT_INSET);\n    grounded = 0;\n\n    if (player_dy < 0) {\n        probe_y = new_pixel_y + PLAYER_TOP_INSET;\n        left_block = map_block_at(left_x, probe_y);\n        right_block = map_block_at(right_x, probe_y);\n        if ((is_solid(left_block) != 0) || (is_solid(right_block) != 0)) {\n            surface_y = (int16_t)(((probe_y / 16) + 1) * 16);\n            player_y = (surface_y - PLAYER_TOP_INSET) * POSITION_SCALE;\n            player_dy = 0;\n            return;\n        }\n        player_y = candidate;\n        return;\n    }\n\n    probe_y = new_pixel_y + PLAYER_HEIGHT;\n    surface_y = (int16_t)((probe_y / 16) * 16);\n    if ((old_pixel_y + PLAYER_HEIGHT) <= surface_y) {\n        left_block = map_block_at(left_x, surface_y);\n        right_block = map_block_at(right_x, surface_y);\n        if ((is_platform(left_block) != 0) ||\n            (is_platform(right_block) != 0) ||\n            (is_solid(left_block) != 0) ||\n            (is_solid(right_block) != 0)) {\n            player_y = (surface_y - PLAYER_HEIGHT) * POSITION_SCALE;\n            player_dy = 0;\n            grounded = 1;\n            return;\n        }\n    }\n\n    player_y = candidate;\n}\n\nvoid reset_player(void) {\n    player_x = PLAYER_START_X;\n    player_y = PLAYER_START_Y;\n    player_dx = 0;\n    player_dy = 0;\n    grounded = 1;\n}\n\nvoid position_player_sprite(void) {\n    uint16_t world_x;\n    uint16_t screen_x;\n    uint16_t vic_x;\n    int16_t world_y;\n    int16_t vic_y;\n\n    world_x = (uint16_t)(player_x / POSITION_SCALE);\n    world_y = player_y / POSITION_SCALE;\n    screen_x = world_x;\n    vic_x = screen_x + 24;\n    vic_y = world_y + 50;\n\n    *((uint8_t*)VIC_SPRITE0_X) = (uint8_t)vic_x;\n    *((uint8_t*)VIC_SPRITE0_Y) = (uint8_t)vic_y;\n    if (vic_x >= 256) {\n        *((uint8_t*)VIC_SPRITE_X_MSB) = 1;\n    } else {\n        *((uint8_t*)VIC_SPRITE_X_MSB) = 0;\n    }\n}\n\nvoid update_player(void) {\n    read_joystick();\n    update_horizontal_input();\n    update_jump();\n    apply_gravity();\n    move_horizontal();\n    move_vertical();\n\n    if ((player_y / POSITION_SCALE) > MAP_PIXEL_HEIGHT + 24) {\n        reset_player();\n    }\n\n    position_player_sprite();\n}\n\nvoid main(void) {\n    setup_video();\n    position_player_sprite();\n\n    while (1) {\n      \t//VIC->border_color = COLOR_RED;\n        wait_frame();\n      \t//VIC->border_color = COLOR_GREEN;\n        update_player();\n    }\n}\n"
    },
