  "savedAt": "2026-08-19T13:45:46.730Z",
  "main": {
    "fileName": "main.c",
    "origin": "$5000",
    "source": "#include <stdint.h>\n#include <c64.h>\n#include <6502.h>\n#include <assets/generated.h>\n#include <web64/world.h>\n#include <web64/sprite-runtime.h>\n#include \"src/world-scroll.h\"\n\n#define WORLD_SCREEN ((uint8_t*)0x0400)\n#define WORLD_COLOR_RAM ((uint8_t*)0xd800)\n#define WORLD_CHARSET ((uint8_t*)0x2000)\n#define PLAYER_SPRITES ((uint8_t*)0x3000)\n#define SPRITE_POINTERS ((uint8_t*)0x07f8)\n#define PLAYER_SPRITE_POINTER 0xc0\n#define VIEW_ROWS 22\n\nWeb64SpriteRenderer sprite_renderer;\nuint16_t marker_x;\nuint8_t marker_y;\nuint8_t camera_request;\n\n\nstatic void wait_frame(void) {\n  uint8_t raster;\n  raster = *((uint8_t*)0xd012);\n  while (raster != 255) {\n    raster = *((uint8_t*)0xd012);\n  }\n}\n\nstatic void install_assets(void) {\n  *((uint8_t*)0xdd00) = (*((uint8_t*)0xdd00) & 0xfc) | 3;\n  web64_world_copy_asset(WORLD_CHARSET, world_chars, world_chars_size);\n  web64_world_copy_asset(PLAYER_SPRITES, player_sprites, player_sprites_size);\n}\n\nstatic void update_gameplay(void) {\n  uint8_t joy;\n  joy = *((uint8_t*)JOYPORT_2);\n  camera_request = WEB64_SCROLL_NONE;\n  if ((joy & 4) == 0) camera_request = WEB64_SCROLL_LEFT;\n  if ((joy & 8) == 0) camera_request = WEB64_SCROLL_RIGHT;\n  if ((joy & 1) == 0 && marker_y > 54) marker_y = marker_y - 1;\n  if ((joy & 2) == 0 && marker_y < 220) marker_y = marker_y + 1;\n}\n\nstatic void render_actor(void) {\n  web64_sprite_render(&sprite_renderer, 0, marker_x, marker_y, PLAYER_SPRITE_POINTER, COLOR_WHITE, WEB64_SPRITE_VISIBLE);\n}\n\n\nstatic void initialize_world(void) {\n  SEI();\n  install_assets();\n  asm_world_scroll_init();\n  web64_sprite_renderer_init(&sprite_renderer, (uint16_t)SPRITE_POINTERS);\n  marker_x = 160;\n  marker_y = 126;\n  camera_request = WEB64_SCROLL_NONE;\n  render_actor();\n}\n\nvoid main(void) {\n  initialize_world();\n  while (1) {\n    update_gameplay();\n    asm_world_scroll_step(camera_request);\n    wait_frame();\n    asm_world_scroll_present();\n    render_actor();\n  }\n}\n",
    "selectedEntryLabel": "auto"
  },
