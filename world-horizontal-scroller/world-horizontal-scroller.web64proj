      "source": "; Generated Web64 Game Runtime World double-buffered scroller.\n; The displayed page is never modified. A complete next viewport is rendered into\n; one hidden page, then three staged VIC registers are committed during vblank.\n.import binary world_map, \"assets/maps/world.w64map\"\n\nWORLD_MAP_WIDTH = 80\nWORLD_MAP_HEIGHT = 25\nWORLD_MAX_X = 40\nWORLD_MAX_Y = 3\nWORLD_VIEW_ROWS = 22\nWORLD_D016_BASE = $00\n\nasm_world_scroll_init:\n    sei\n    lda #$7f\n    sta $dc0d\n    sta $dd0d\n    lda $dc0d\n    lda $dd0d\n    lda #0\n    sta $d011\n    sta $d020\n    sta $d021\n    sta $d015\n    sta $d01c\n    sta world_current_page\n    sta world_camera_cell_x\n    sta world_camera_cell_y\n    sta world_pixel_x_lo\n    sta world_pixel_x_hi\n    sta world_pixel_y_lo\n    sta world_pixel_y_hi\n    sta world_motion_phase\n    sta world_scroll_direction\n    sta world_present_pending\n    sta world_temp_x\n    sta world_temp_y\n    jsr world_render_current\n    lda #$c0\n    sta $07f8\n    sta $0bf8\n    ldx #0\n    lda #14\nworld_fill_color_pages:\n    sta $d800,x\n    sta $d900,x\n    sta $da00,x\n    inx\n    bne world_fill_color_pages\n    ldx #0\nworld_fill_color_tail:\n    sta $db00,x\n    inx\n    cpx #$e8\n    bne world_fill_color_tail\n    lda #0\n    jsr world_select_page\n    lda #7\n    jsr world_set_fine_x\n    lda #7\n    jsr world_set_fine_y\n    jsr asm_world_scroll_present\n    rts\n\nasm_world_scroll_present:\n    lda world_vic_d018\n    sta $d018\n    lda world_vic_d016\n    sta $d016\n    lda world_vic_d011\n    sta $d011\n    lda world_present_pending\n    cmp #1\n    bne world_present_cancel_check\n    jsr world_finalize_transition\n    jmp world_present_finalize_done\nworld_present_cancel_check:\n    cmp #2\n    bne world_present_finalize_done\nworld_present_finalize_done:\n    lda #0\n    sta world_present_pending\n    rts\n\nasm_world_scroll_step:\n    sta world_scroll_request\n    lda world_present_pending\n    beq world_step_ready\n    rts\nworld_step_ready:\n    lda world_motion_phase\n    beq world_step_begin\n    lda world_scroll_request\n    beq world_step_done\n    cmp world_scroll_direction\n    beq world_step_continue\n    jsr world_is_opposite_request\n    bne world_step_reverse\nworld_step_continue:\n    inc world_motion_phase\n    jsr world_apply_phase\n    lda world_motion_phase\n    cmp #8\n    bne world_step_done\n    jsr world_commit_transition\nworld_step_done:\n    rts\nworld_step_reverse:\n    jmp world_reverse_phase\nworld_step_begin:\n    lda world_scroll_request\n    beq world_step_done\n    sta world_scroll_direction\n    cmp #1\n    bne world_begin_right_dispatch\n    jmp world_begin_left\nworld_begin_right_dispatch:\n    cmp #2\n    bne world_begin_up_dispatch\n    jmp world_begin_right\nworld_begin_up_dispatch:\n    cmp #3\n    bne world_begin_down_dispatch\n    jmp world_begin_invalid\nworld_begin_down_dispatch:\n    cmp #4\n    beq world_begin_down_dispatch_match\n    jmp world_begin_invalid\nworld_begin_down_dispatch_match:\n    jmp world_begin_invalid\n\nworld_begin_left:\n    lda world_camera_cell_x\n    bne world_begin_left_decrement\n    jmp world_begin_invalid\nworld_begin_left_decrement:\n    sec\n    sbc #1\n    sta world_target_x\n    jmp world_begin_copy_y\nworld_begin_right:\n    lda world_camera_cell_x\n    cmp #WORLD_MAX_X\n    bcc world_begin_right_increment\n    jmp world_begin_invalid\nworld_begin_right_increment:\n    clc\n    adc #1\n    sta world_target_x\nworld_begin_copy_y:\n    lda world_camera_cell_y\n    sta world_target_y\n    jmp world_begin_ready\nworld_begin_up:\n    lda world_camera_cell_y\n    bne world_begin_up_decrement\n    jmp world_begin_invalid\nworld_begin_up_decrement:\n    sec\n    sbc #1\n    sta world_target_y\n    jmp world_begin_copy_x\nworld_begin_down:\n    lda world_camera_cell_y\n    cmp #WORLD_MAX_Y\n    bcc world_begin_down_increment\n    jmp world_begin_invalid\nworld_begin_down_increment:\n    clc\n    adc #1\n    sta world_target_y\nworld_begin_copy_x:\n    lda world_camera_cell_x\n    sta world_target_x\nworld_begin_ready:\n    lda world_current_page\n    eor #1\n    sta world_target_page\n    lda world_target_x\n    sta world_temp_x\n    lda world_target_y\n    sta world_temp_y\n    jsr world_render_target\n    lda #1\n    sta world_motion_phase\n    jsr world_apply_phase\n    rts\nworld_begin_invalid:\n    lda #0\n    sta world_scroll_direction\n    rts\n\nworld_apply_phase:\n    lda world_scroll_direction\n    cmp #1\n    beq world_apply_left\n    cmp #2\n    beq world_apply_right\n    cmp #3\n    beq world_apply_done\n    cmp #4\n    beq world_apply_done\nworld_apply_done:\n    rts\n\nworld_apply_left:\n    jsr world_decrement_pixel_x\n    lda world_motion_phase\n    cmp #1\n    bne world_apply_left_fine\n    lda world_target_page\n    jsr world_select_page\nworld_apply_left_fine:\n    lda world_motion_phase\n    sec\n    sbc #1\n    jsr world_set_fine_x\n    rts\n\nworld_apply_right:\n    jsr world_increment_pixel_x\n    lda world_motion_phase\n    cmp #8\n    bne world_apply_right_fine\n    lda world_target_page\n    jsr world_select_page\n    lda #7\n    jsr world_set_fine_x\n    rts\nworld_apply_right_fine:\n    lda #7\n    sec\n    sbc world_motion_phase\n    jsr world_set_fine_x\n    rts\n\nworld_reverse_phase:\n    lda world_scroll_direction\n    cmp #1\n    beq world_reverse_left\n    cmp #2\n    beq world_reverse_right\n    cmp #3\n    beq world_reverse_done\n    cmp #4\n    beq world_reverse_done\nworld_reverse_done:\n    rts\n\nworld_reverse_left:\n    jsr world_increment_pixel_x\n    dec world_motion_phase\n    lda world_motion_phase\n    beq world_reverse_left_cancel\n    sec\n    sbc #1\n    jsr world_set_fine_x\n    rts\nworld_reverse_left_cancel:\n    lda world_current_page\n    jsr world_select_page\n    lda #7\n    jsr world_set_fine_x\n    jmp world_cancel_transition\n\nworld_reverse_right:\n    jsr world_decrement_pixel_x\n    dec world_motion_phase\n    lda world_motion_phase\n    beq world_reverse_right_cancel\n    lda #7\n    sec\n    sbc world_motion_phase\n    jsr world_set_fine_x\n    rts\nworld_reverse_right_cancel:\n    lda #7\n    jsr world_set_fine_x\n    jmp world_cancel_transition\n\nworld_cancel_transition:\n    lda #2\n    sta world_present_pending\n    lda #0\n    sta world_motion_phase\n    sta world_scroll_direction\n    rts\n\nworld_commit_transition:\n    lda #1\n    sta world_present_pending\n    rts\n\nworld_finalize_transition:\n    lda world_target_page\n    sta world_current_page\n    lda world_target_x\n    sta world_camera_cell_x\n    sta world_pixel_x_lo\n    lda #0\n    sta world_pixel_x_hi\n    asl world_pixel_x_lo\n    rol world_pixel_x_hi\n    asl world_pixel_x_lo\n    rol world_pixel_x_hi\n    asl world_pixel_x_lo\n    rol world_pixel_x_hi\n    lda world_target_y\n    sta world_camera_cell_y\n    sta world_pixel_y_lo\n    lda #0\n    sta world_pixel_y_hi\n    asl world_pixel_y_lo\n    rol world_pixel_y_hi\n    asl world_pixel_y_lo\n    rol world_pixel_y_hi\n    asl world_pixel_y_lo\n    rol world_pixel_y_hi\n    lda #0\n    sta world_motion_phase\n    sta world_scroll_direction\n    rts\n\nworld_render_current:\n    lda world_current_page\n    sta world_temp_page\n    jmp world_render_page\nworld_render_target:\n    lda world_target_page\n    sta world_temp_page\nworld_render_page:\n    ldx world_temp_page\n    lda world_temp_x\n    sta world_page_x,x\n    lda world_temp_y\n    sta world_page_y,x\n    lda #<world_map\n    sta $fb\n    lda #>world_map\n    sta $fc\n    ldx world_temp_y\nworld_render_source_rows:\n    cpx #0\n    beq world_render_source_column\n    clc\n    lda $fb\n    adc #WORLD_MAP_WIDTH\n    sta $fb\n    lda $fc\n    adc #0\n    sta $fc\n    dex\n    jmp world_render_source_rows\nworld_render_source_column:\n    clc\n    lda $fb\n    adc world_temp_x\n    sta $fb\n    lda $fc\n    adc #0\n    sta $fc\n    ldx world_temp_page\n    lda world_screen_lo,x\n    sta $fd\n    lda world_screen_hi,x\n    sta $fe\n    lda #WORLD_VIEW_ROWS\n    sta world_rows\nworld_render_row:\n    ldy #0\n    lda ($fb),y\n    sta ($fd),y\n    ldy #1\n    lda ($fb),y\n    sta ($fd),y\n    ldy #2\n    lda ($fb),y\n    sta ($fd),y\n    ldy #3\n    lda ($fb),y\n    sta ($fd),y\n    ldy #4\n    lda ($fb),y\n    sta ($fd),y\n    ldy #5\n    lda ($fb),y\n    sta ($fd),y\n    ldy #6\n    lda ($fb),y\n    sta ($fd),y\n    ldy #7\n    lda ($fb),y\n    sta ($fd),y\n    ldy #8\n    lda ($fb),y\n    sta ($fd),y\n    ldy #9\n    lda ($fb),y\n    sta ($fd),y\n    ldy #10\n    lda ($fb),y\n    sta ($fd),y\n    ldy #11\n    lda ($fb),y\n    sta ($fd),y\n    ldy #12\n    lda ($fb),y\n    sta ($fd),y\n    ldy #13\n    lda ($fb),y\n    sta ($fd),y\n    ldy #14\n    lda ($fb),y\n    sta ($fd),y\n    ldy #15\n    lda ($fb),y\n    sta ($fd),y\n    ldy #16\n    lda ($fb),y\n    sta ($fd),y\n    ldy #17\n    lda ($fb),y\n    sta ($fd),y\n    ldy #18\n    lda ($fb),y\n    sta ($fd),y\n    ldy #19\n    lda ($fb),y\n    sta ($fd),y\n    ldy #20\n    lda ($fb),y\n    sta ($fd),y\n    ldy #21\n    lda ($fb),y\n    sta ($fd),y\n    ldy #22\n    lda ($fb),y\n    sta ($fd),y\n    ldy #23\n    lda ($fb),y\n    sta ($fd),y\n    ldy #24\n    lda ($fb),y\n    sta ($fd),y\n    ldy #25\n    lda ($fb),y\n    sta ($fd),y\n    ldy #26\n    lda ($fb),y\n    sta ($fd),y\n    ldy #27\n    lda ($fb),y\n    sta ($fd),y\n    ldy #28\n    lda ($fb),y\n    sta ($fd),y\n    ldy #29\n    lda ($fb),y\n    sta ($fd),y\n    ldy #30\n    lda ($fb),y\n    sta ($fd),y\n    ldy #31\n    lda ($fb),y\n    sta ($fd),y\n    ldy #32\n    lda ($fb),y\n    sta ($fd),y\n    ldy #33\n    lda ($fb),y\n    sta ($fd),y\n    ldy #34\n    lda ($fb),y\n    sta ($fd),y\n    ldy #35\n    lda ($fb),y\n    sta ($fd),y\n    ldy #36\n    lda ($fb),y\n    sta ($fd),y\n    ldy #37\n    lda ($fb),y\n    sta ($fd),y\n    ldy #38\n    lda ($fb),y\n    sta ($fd),y\n    ldy #39\n    lda ($fb),y\n    sta ($fd),y\n    clc\n    lda $fb\n    adc #WORLD_MAP_WIDTH\n    sta $fb\n    lda $fc\n    adc #0\n    sta $fc\n    clc\n    lda $fd\n    adc #40\n    sta $fd\n    lda $fe\n    adc #0\n    sta $fe\n    dec world_rows\n    beq world_render_rows_done\n    jmp world_render_row\nworld_render_rows_done:\n    ldy #0\n    lda #0\nworld_render_clear_tail:\n    sta ($fd),y\n    iny\n    cpy #120\n    bne world_render_clear_tail\n    rts\n\n\nworld_set_fine_x:\n    and #7\n    ora #WORLD_D016_BASE\n    sta world_vic_d016\n    rts\nworld_set_fine_y:\n    and #7\n    ora #$18\n    sta world_vic_d011\n    rts\nworld_select_page:\n    tax\n    lda world_screen_d018,x\n    sta world_vic_d018\n    rts\n\n\nworld_is_opposite_request:\n    lda world_scroll_request\n    clc\n    adc world_scroll_direction\n    cmp #3\n    beq world_opposite_yes\n    cmp #7\n    beq world_opposite_yes\n    lda #0\n    rts\nworld_opposite_yes:\n    lda #1\n    rts\n\nworld_increment_pixel_x:\n    inc world_pixel_x_lo\n    bne world_increment_pixel_x_done\n    inc world_pixel_x_hi\nworld_increment_pixel_x_done:\n    rts\nworld_decrement_pixel_x:\n    lda world_pixel_x_lo\n    bne world_decrement_pixel_x_low\n    dec world_pixel_x_hi\nworld_decrement_pixel_x_low:\n    dec world_pixel_x_lo\n    rts\nworld_increment_pixel_y:\n    inc world_pixel_y_lo\n    bne world_increment_pixel_y_done\n    inc world_pixel_y_hi\nworld_increment_pixel_y_done:\n    rts\nworld_decrement_pixel_y:\n    lda world_pixel_y_lo\n    bne world_decrement_pixel_y_low\n    dec world_pixel_y_hi\nworld_decrement_pixel_y_low:\n    dec world_pixel_y_lo\n    rts\n\nasm_world_scroll_pixel_x:\n    lda world_pixel_x_lo\n    ldx world_pixel_x_hi\n    rts\nasm_world_scroll_pixel_y:\n    lda world_pixel_y_lo\n    ldx world_pixel_y_hi\n    rts\n\nworld_screen_lo: .byte $00,$00\nworld_screen_hi: .byte $04,$08\nworld_screen_d018: .byte $18,$28\nworld_page_x: .byte 0,0\nworld_page_y: .byte 0,0\nworld_vic_d011: .byte 0\nworld_vic_d016: .byte 0\nworld_vic_d018: .byte 0\nworld_current_page: .byte 0\nworld_target_page: .byte 0\nworld_scroll_request: .byte 0\nworld_scroll_direction: .byte 0\nworld_motion_phase: .byte 0\nworld_present_pending: .byte 0\nworld_camera_cell_x: .byte 0\nworld_camera_cell_y: .byte 0\nworld_target_x: .byte 0\nworld_target_y: .byte 0\nworld_pixel_x_lo: .byte 0\nworld_pixel_x_hi: .byte 0\nworld_pixel_y_lo: .byte 0\nworld_pixel_y_hi: .byte 0\nworld_temp_page: .byte 0\nworld_temp_x: .byte 0\nworld_temp_y: .byte 0\nworld_rows: .byte 0\n"
