  "savedAt": "2026-09-20T14:22:19.539Z",
  "main": {
    "fileName": "main.asm",
    "origin": "$8000",
    "source": "; Noise-shaped 4-bit speech on SID $d418, one byte every 123 PAL cycles.\n; The display is blanked during playback to avoid VIC badline jitter.\n* = $8000\n\npages_left = $fa\nptr = $fb\n\nstart:\n    lda #147\n    jsr $ffd2\n    sei\n    lda $01\n    sta saved_port\n    lda #$36\n    sta $01            ; expose RAM at $a000-$bfff; keep SID I/O visible\n    lda #$7f\n    sta $dc0d\n    lda $dc0d\n    lda #0\n    sta $d01a\n    sta $d015\n    sta $d021\n    lda #6\n    sta $d020\n\n    ldx #15\ndraw_title:\n    lda title,x\n    sta $05ec,x\n    lda #1\n    sta $d9ec,x\n    dex\n    bpl draw_title\n\n    lda #$0b\n    sta $d011          ; DEN off: no VIC badlines during audio\n    lda #0\n    ldx #$18\nclear_sid:\n    sta $d400,x\n    dex\n    bpl clear_sid\n    lda #$ff\n    sta $d406          ; full sustain for one DC pulse voice (8580 digi boost)\n    lda #$49\n    sta $d404          ; TEST + pulse + gate: fixed DC bias\n    lda #8\n    sta $d418          ; start at the sample's neutral DC level\n\n    lda #<speech_data\n    sta ptr\n    lda #>speech_data\n    sta ptr+1\n    lda #65\n    sta pages_left\n    ldy #0\n\n; Ordinary and page-wrap paths both take 123 cycles per sample:\n; 5 load + 4 SID write + 2 INY + 18 branch path + 91 padding + 3 JMP.\nsample_loop:\n    lda (ptr),y        ; 5: page-aligned data avoids indexed page crossing\n    sta $d418          ; 4: low nibble is the 4-bit sample\n    iny                ; 2\n    beq next_page      ; 2 normally, 3 at page end\n    nop                ; 10 + 3 + 3 = 16; normal path totals 18\n    nop\n    nop\n    nop\n    nop\n    bit $ea\n    jmp delay\nnext_page:\n    inc ptr+1          ; 5\n    dec pages_left     ; 5\n    beq finished       ; 2 except on final sample\n    jmp delay          ; page path also totals 18\ndelay:\n    .fill 44,$ea       ; 88\n    bit $ea            ; 3\n    jmp sample_loop    ; 3\n\nfinished:\n    ; The padded sample ends at level 8; hold it instead of clicking to zero.\n    lda #$1b\n    sta $d011          ; show centered title again\n    lda $dc0d\n    lda #$81\n    sta $dc0d          ; restore KERNAL timer-A IRQ mask\n    lda saved_port\n    sta $01            ; restore caller's ROM/RAM mapping\n    cli\nidle:\n    jmp idle\n\nsaved_port: .byte 0\n\ntitle:\n    .byte 23,5,12,3,15,13,5,32,20,15,32,23,5,2,54,52\n\n* = $8200\n.incbin speech_data, \"assets/welcome.bin\"\nspeech_end:\n",
    "selectedEntryLabel": "start"
  },
