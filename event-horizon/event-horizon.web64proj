a $50fe\n    sta $50ff\n    rts\nclear_core51:\n    sta $5100\n    sta $5101\n    sta $5102\n    sta $5103\n    sta $5104\n    sta $5105\n    sta $5106\n    sta $5107\n    sta $5108\n    sta $5109\n    sta $510a\n    sta $510b\n    sta $510c\n    sta $510d\n    sta $510e\n    sta $510f\n    sta $5110\n    sta $5111\n    sta $5112\n    sta $5113\n    sta $5114\n    sta $5115\n    sta $5116\n    sta $5117\n    sta $5118\n    sta $5119\n    sta $511a\n    sta $511b\n    sta $511c\n    sta $511d\n    sta $511e\n    sta $511f\n    sta $5120\n    sta $5121\n    sta $5122\n    sta $5123\n    sta $5124\n    sta $5125\n    sta $5126\n    sta $5127\n    sta $5128\n    sta $5129\n    sta $512a\n    sta $512b\n    sta $512c\n    sta $512d\n    sta $512e\n    sta $512f\n    sta $5130\n    sta $5131\n    sta $5132\n    sta $5133\n    sta $5134\n    sta $5135\n    sta $5136\n    sta $5137\n    sta $5138\n    sta $5139\n    sta $513a\n    sta $513b\n    sta $513c\n    sta $513d\n    sta $513e\n    sta $513f\n    sta $5140\n    sta $5141\n    sta $5142\n    sta $5143\n    sta $5144\n    sta $5145\n    sta $5146\n    sta $5147\n    sta $5148\n    sta $5149\n    sta $514a\n    sta $514b\n    sta $514c\n    sta $514d\n    sta $514e\n    sta $514f\n    sta $5150\n    sta $5151\n    sta $5152\n    sta $5153\n    sta $5154\n    sta $5155\n    sta $5156\n    sta $5157\n    sta $5158\n    sta $5159\n    sta $515a\n    sta $515b\n    sta $515c\n    sta $515d\n    sta $515e\n    sta $515f\n    sta $5160\n    sta $5161\n    sta $5162\n    sta $5163\n    sta $5164\n    sta $5165\n    sta $5166\n    sta $5167\n    sta $5168\n    sta $5169\n    sta $516a\n    sta $516b\n    sta $516c\n    sta $516d\n    sta $516e\n    sta $516f\n    sta $5170\n    sta $5171\n    sta $5172\n    sta $5173\n    sta $5174\n    sta $5175\n    sta $5176\n    sta $5177\n    sta $5178\n    sta $5179\n    sta $517a\n    sta $517b\n    sta $517c\n    sta $517d\n    sta $517e\n    sta $517f\n    sta $5180\n    sta $5181\n    sta $5182\n    sta $5183\n    sta $5184\n    sta $5185\n    sta $5186\n    sta $5187\n    sta $5188\n    sta $5189\n    sta $518a\n    sta $518b\n    sta $518c\n    sta $518d\n    sta $518e\n    sta $518f\n    sta $5190\n    sta $5191\n    sta $5192\n    sta $5193\n    sta $5194\n    sta $5195\n    sta $5196\n    sta $5197\n    sta $5198\n    sta $5199\n    sta $519a\n    sta $519b\n    sta $519c\n    sta $519d\n    sta $519e\n    sta $519f\n    sta $51a0\n    sta $51a1\n    sta $51a2\n    sta $51a3\n    sta $51a4\n    sta $51a5\n    sta $51a6\n    sta $51a7\n    sta $51a8\n    sta $51a9\n    sta $51aa\n    sta $51ab\n    sta $51ac\n    sta $51ad\n    sta $51ae\n    sta $51af\n    sta $51b0\n    sta $51b1\n    sta $51b2\n    sta $51b3\n    sta $51b4\n    sta $51b5\n    sta $51b6\n    sta $51b7\n    sta $51b8\n    sta $51b9\n    sta $51ba\n    sta $51bb\n    sta $51bc\n    sta $51bd\n    sta $51be\n    sta $51bf\n    sta $51c0\n    sta $51c1\n    sta $51c2\n    sta $51c3\n    sta $51c4\n    sta $51c5\n    sta $51c6\n    sta $51c7\n    sta $51c8\n    sta $51c9\n    sta $51ca\n    sta $51cb\n    sta $51cc\n    sta $51cd\n    sta $51ce\n    sta $51cf\n    sta $51d0\n    sta $51d1\n    sta $51d2\n    sta $51d3\n    sta $51d4\n    sta $51d5\n    sta $51d6\n    sta $51d7\n    sta $51d8\n    sta $51d9\n    sta $51da\n    sta $51db\n    sta $51dc\n    sta $51dd\n    sta $51de\n    sta $51df\n    sta $51e0\n    sta $51e1\n    sta $51e2\n    sta $51e3\n    sta $51e4\n    sta $51e5\n    sta $51e6\n    sta $51e7\n    sta $51e8\n    sta $51e9\n    sta $51ea\n    sta $51eb\n    sta $51ec\n    sta $51ed\n    sta $51ee\n    sta $51ef\n    sta $51f0\n    sta $51f1\n    sta $51f2\n    sta $51f3\n    sta $51f4\n    sta $51f5\n    sta $51f6\n    sta $51f7\n    sta $51f8\n    sta $51f9\n    sta $51fa\n    sta $51fb\n    sta $51fc\n    sta $51fd\n    sta $51fe\n    sta $51ff\n    rts\n"
