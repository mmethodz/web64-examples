      "kind": "source",
      "source": "#ifndef WEB64_EXAMPLE_ROTATION_MATRICES_H\n\n#define WEB64_EXAMPLE_ROTATION_MATRICES_H\n\n#include <web64/fixed.h>\n\n/* Web64 generated v1; kind=matrix; preset=rotation3d-x; samples=32; type=web64_fix8_8; layout=interleaved; shape=multidimensional; encoding=word; endpoint=excluded; overflow=error; dimensions=32x3x3; convention=row-major storage; column-vector math */\n#define ROTATION_X_COUNT 32\n#define ROTATION_X_ROWS 3\n#define ROTATION_X_COLUMNS 3\n#define ROTATION_X_STEPS 32\n#define ROTATION_X_COEFFICIENTS 9\nstatic const web64_fix8_8 rotation_x[32][3][3] = {\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 256, 0\n        },\n        {\n            0, 0, 256\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 251, -50\n        },\n        {\n            0, 50, 251\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 237, -98\n        },\n        {\n            0, 98, 237\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 213, -142\n        },\n        {\n            0, 142, 213\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 181, -181\n        },\n        {\n            0, 181, 181\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 142, -213\n        },\n        {\n            0, 213, 142\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 98, -237\n        },\n        {\n            0, 237, 98\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 50, -251\n        },\n        {\n            0, 251, 50\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, 0, -256\n        },\n        {\n            0, 256, 0\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -50, -251\n        },\n        {\n            0, 251, -50\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -98, -237\n        },\n        {\n            0, 237, -98\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -142, -213\n        },\n        {\n            0, 213, -142\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -181, -181\n        },\n        {\n            0, 181, -181\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -213, -142\n        },\n        {\n            0, 142, -213\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -237, -98\n        },\n        {\n            0, 98, -237\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -251, -50\n        },\n        {\n            0, 50, -251\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -256, 0\n        },\n        {\n            0, 0, -256\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -251, 50\n        },\n        {\n            0, -50, -251\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -237, 98\n        },\n        {\n            0, -98, -237\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -213, 142\n        },\n        {\n            0, -142, -213\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -181, 181\n        },\n        {\n            0, -181, -181\n        }\n    },\n    {\n        {\n            256, 0, 0\n        },\n        {\n            0, -142, 213\n        },\n        {\n         