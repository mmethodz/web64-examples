    "source": "#ifndef WEB64_ASSETS_GENERATED_H\n#define WEB64_ASSETS_GENERATED_H\n#include <web64/assets.h>\nextern const unsigned char blocks[];\nextern const unsigned char blocks_end[];\n#define blocks_size 204\n#define blocks_kind 8\n#define blocks_packed_size 204\n#define blocks_unpacked_size 204\n#define blocks_compression 044\n#define blocks_data blocks\n#define blocks_bytes blocks\n#define blocks_readonly 1\nextern const Web64BlockSetAsset blocks_asset;\n#define blocks_descriptor blocks_asset\n#define blocks_descriptor_size 15\n#define blocks_block_count 51\n#define blocks_width 2\n#define blocks_height 2\n#define blocks_bytes_per_block 4\n#define blocks_index_width 1\n#define blocks_flags 0\nextern const unsigned char bumps[];\nextern const unsigned char bumps_end[];\n#define bumps_size 2048\n#define bumps_kind 3\n#define bumps_packed_size 2048\n#define bumps_unpacked_size 2048\n#define bumps_compression 0\n#define bumps_data bumps\n#define bumps_bytes bumps\n#define bumps_readonly 1\nextern const Web64CharsetAsset bumps_asset;\n#define bumps_descriptor bumps_asset\n#define bumps_descriptor_size 8\n#define bumps_char_count 256\n#define bumps_bytes_per_char 8\n#define bumps_mode 1\nextern const unsigned char map[];\nextern const unsigned char map_end[];\n#define map_size 240\n#define map_kind 9\n#define map_packed_size 240\n#define map_unpacked_size 240\n#define map_compression 0\n#define map_data map\n#define map_bytes map\n#define map_readonly 1\nextern const Web64MapAsset map_asset;\n#define map_descriptor map_asset\n#define map_descriptor_size 18\n#define map_width 20\n#define map_height 12\n#define map_cell_count 240\n#define map_cell_type 1\n#define map_index_width 1\n#define map_flags 1\nextern const unsigned char title[];\nextern const unsigned char title_end[];\n#define title_size 2408\n#define title_kind 10\n#define title_packed_size 2408\n#define title_unpacked_size 2408\n#define title_compression 0\n#define title_data title\n#define title_bytes title\n#define title_readonly 1\nextern const Web64SidAsset title_asset;\n#define title_descriptor title_asset\n#define title_descriptor_size 24\n#define title_file_size 2408\n#define title_data_offset 124\n#define title_c64_data_offset 124\n#define title_c64_data_size 2284\n#define title_load_address 4096\n#define title_init_address 4096\n#define title_play_address 4249\n#define title_song_count 4\n#define title_start_song 1\n#define title_speed_flags 0\n#define title_flags 20\n#define title_c64_data (title + title_c64_data_offset)\n#define title_payload title_c64_data\n#define title_payload_size title_c64_data_size\nextern const unsigned char bank_2[];\nextern const unsigned char bank_2_end[];\n#define bank_2_size 576\n#define bank_2_kind 4\n#define bank_2_packed_size 576\n#define bank_2_unpacked_size 576\n#define bank_2_compression 0\n#define bank_2_data bank_2\n#define bank_2_bytes bank_2\n#define bank_2_readonly 1\nextern const Web64SpriteAsset bank_2_asset;\n#define bank_2_descriptor bank_2_asset\n#define bank_2_descriptor_size 15\n#define bank_2_frame_count 9\n#define bank_2_bytes_per_frame 64\n#define bank_2_payload_bytes_per_frame 63\n#define bank_2_width 24\n#define bank_2_height 21\n#define bank_2_mode 1\n#define bank_2_data_block 255\nextern const unsigned char c_joy[];\nextern const unsigned char c_joy_end[];\n#define c_joy_size 256\n#define c_joy_kind 4\n#define c_joy_packed_size 256\n#define c_joy_unpacked_size 256\n#define c_joy_compression 0\n#define c_joy_data c_joy\n#define c_joy_bytes c_joy\n#define c_joy_readonly 1\nextern const Web64SpriteAsset c_joy_asset;\n#define c_joy_descriptor c_joy_asset\n#define c_joy_descriptor_size 15\n#define c_joy_frame_count 4\n#define c_joy_bytes_per_frame 64\n#define c_joy_payload_bytes_per_frame 63\n#define c_joy_width 24\n#define c_joy_height 21\n#define c_joy_mode 1\n#define c_joy_data_block 255\nextern const unsigned char enemy[];\nextern const unsigned char enemy_end[];\n#define enemy_size 256\n#define enemy_kind 4\n#define enemy_packed_size 256\n#define enemy_unpacked_size 256\n#define enemy_compression 0\n#define enemy_data enemy\n#define enemy_bytes enemy\n#define enemy_readonly 1\nextern const Web64SpriteAsset enemy_asset;\n#define enemy_descriptor enemy_asset\n#define enemy_descriptor_size 15\n#define enemy_frame_count 4\n#define enemy_bytes_per_frame 64\n#define enemy_payload_bytes_per_frame 63\n#define enemy_width 24\n#define enemy_height 21\n#define enemy_mode 1\n#define enemy_data_block 255\n#endif",
    "selectedEntryLabel": "auto"
  },
